<UserControl x:Class="HistoryVulcan.Shell.Views.CommandDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 视图是独立 BAML:StaticResource 必须在自己的作用域里找得到 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HistoryVulcan.Shell;component/Themes/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                   Margin="0,6,0,0" TextWrapping="Wrap" />

        <TabControl x:Name="DetailTabs" IsEnabled="False">
            <TabItem Header="Help">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0" x:Name="SummaryBox" IsReadOnly="True" TextWrapping="Wrap"
                             Background="{DynamicResource Shell.Brush.SurfaceAlt}" MaxHeight="80" />
                    <TextBlock Grid.Row="1" Text="参数" Foreground="{DynamicResource Shell.Brush.TextSecondary}" FontSize="{DynamicResource Shell.Font.Small}" Margin="0,8,0,2" />
                    <ListView Grid.Row="2" x:Name="ParameterList">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource Shell.GridHeader}">
                                <GridViewColumn Header="名称" Width="100" DisplayMemberBinding="{Binding Name}" />
                                <GridViewColumn Header="类型" Width="65" DisplayMemberBinding="{Binding Type}" />
                                <GridViewColumn Header="必填" Width="48" DisplayMemberBinding="{Binding Required}" />
                                <GridViewColumn Header="默认" Width="90" DisplayMemberBinding="{Binding Default}" />
                                <GridViewColumn Header="说明" Width="280" DisplayMemberBinding="{Binding Description}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBox Grid.Row="3" x:Name="ExampleBox" IsReadOnly="True" Margin="0,8,0,0"
                             FontFamily="{DynamicResource Shell.Font.MonoFamily}" Background="{DynamicResource Shell.Brush.SurfaceAlt}" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="查看 Help" Click="OnHelpClick" />
                        <Button x:Name="CopyExampleButton" Content="复制示例" Margin="8,0,0,0"
                                Click="OnCopyExampleClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="MCP">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="McpStatusText" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="JSON Input Schema" Foreground="{DynamicResource Shell.Brush.TextSecondary}" FontSize="{DynamicResource Shell.Font.Small}"
                               Margin="0,8,0,2" />
                    <TextBox Grid.Row="2" x:Name="SchemaBox" IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="{DynamicResource Shell.Font.MonoFamily}" Background="{DynamicResource Shell.Brush.SurfaceAlt}" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    <Button Grid.Row="3" x:Name="ShowSchemaButton" Content="控制台查看 MCP 形态"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnSchemaClick" />
                </Grid>
            </TabItem>

            <TabItem Header="提示词">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="90" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="80" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="RevisionStatusText" Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                               Text="当前修订: (默认)" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="指令默认描述" Foreground="{DynamicResource Shell.Brush.TextSecondary}" FontSize="{DynamicResource Shell.Font.Small}" Margin="0,6,0,2" />
                    <TextBox Grid.Row="2" x:Name="DefaultDescBox" IsReadOnly="True" Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                             Background="{DynamicResource Shell.Brush.SurfaceAlt}" TextWrapping="Wrap" MaxHeight="70"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBox Grid.Row="3" x:Name="DescBox" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,8">
                        <Button x:Name="SaveButton" Content="应用本地修订" Click="OnSaveClick" />
                        <Button x:Name="ResetButton" Content="恢复默认" Margin="8,0,0,0"
                                Click="OnResetClick" />
                    </StackPanel>
                    <TextBlock Grid.Row="5" Text="修订历史" Foreground="{DynamicResource Shell.Brush.TextSecondary}" FontSize="{DynamicResource Shell.Font.Small}" />
                    <ListView Grid.Row="6" x:Name="RevisionList" SelectionChanged="OnRevisionSelected">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource Shell.GridHeader}">
                                <GridViewColumn Header="时间" Width="135" DisplayMemberBinding="{Binding Created}" />
                                <GridViewColumn Header="来源" Width="90" DisplayMemberBinding="{Binding Source}" />
                                <GridViewColumn Header="理由" Width="220" DisplayMemberBinding="{Binding Reason}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <DockPanel Grid.Row="7" Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" x:Name="RevertButton" Content="回滚到所选修订"
                                Margin="8,0,0,0" IsEnabled="False" Click="OnRevertClick" />
                        <TextBox x:Name="RevertReasonBox" ToolTip="回滚理由" VerticalContentAlignment="Center" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="提案审核">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="100" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="70" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="90" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView Grid.Row="0" x:Name="ProposalList" SelectionChanged="OnProposalSelected">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource Shell.GridHeader}">
                                <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding Status}" />
                                <GridViewColumn Header="来源" Width="105" DisplayMemberBinding="{Binding SourceClient}" />
                                <GridViewColumn Header="时间" Width="135" DisplayMemberBinding="{Binding Created}" />
                                <GridViewColumn Header="理由" Width="230" DisplayMemberBinding="{Binding Reason}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="理由与证据" Foreground="{DynamicResource Shell.Brush.TextSecondary}" FontSize="{DynamicResource Shell.Font.Small}" Margin="0,6,0,2" />
                    <TextBox Grid.Row="2" x:Name="ProposalReasonBox" IsReadOnly="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" Background="{DynamicResource Shell.Brush.SurfaceAlt}" />
                    <TextBlock Grid.Row="3" Text="原文 / 建议文本" Foreground="{DynamicResource Shell.Brush.TextSecondary}" FontSize="{DynamicResource Shell.Font.Small}" Margin="0,6,0,2" />
                    <TextBox Grid.Row="4" x:Name="ProposalDiffBox" IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource Shell.Font.MonoFamily}"
                             Background="{DynamicResource Shell.Brush.SurfaceAlt}" />
                    <TextBox Grid.Row="5" x:Name="ReviewReasonBox" Margin="0,6,0,0"
                             ToolTip="拒绝提案时填写理由" />
                    <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="ApproveButton" Content="批准" IsEnabled="False"
                                Click="OnApproveClick" />
                        <Button x:Name="RejectButton" Content="拒绝" Margin="8,0,0,0"
                                IsEnabled="False" Click="OnRejectClick" />
                        <Button x:Name="ApplyButton" Content="应用" Margin="8,0,0,0"
                                IsEnabled="False" Click="OnApplyClick" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="治理历史">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <GroupBox Grid.Row="0" Header="勘误">
                        <ListView x:Name="CorrectionList">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource Shell.GridHeader}">
                                    <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding Status}" />
                                    <GridViewColumn Header="时间" Width="135" DisplayMemberBinding="{Binding Created}" />
                                    <GridViewColumn Header="正确解释" Width="360" DisplayMemberBinding="{Binding Correction}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                    <GridSplitter Grid.Row="1" Background="Transparent" />
                    <GroupBox Grid.Row="2" Header="事故">
                        <ListView x:Name="IncidentList">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource Shell.GridHeader}">
                                    <GridViewColumn Header="时间" Width="135" DisplayMemberBinding="{Binding Created}" />
                                    <GridViewColumn Header="现象" Width="360" DisplayMemberBinding="{Binding Symptom}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
