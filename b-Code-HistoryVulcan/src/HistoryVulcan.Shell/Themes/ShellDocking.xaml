<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock">

    <!--
        UI-01 / UI-04 / UI-06:AvalonDock 覆盖层。

        窗格控件样式必须经 DockingManager.AnchorablePaneControlStyle /
        DocumentPaneControlStyle 属性下发(主题字典里的隐式 Style 不命中窗格控件);
        页签容器样式由那两个样式的 ItemContainerStyle 带下去。
        主题画刷键的覆盖在 ShellTokens[.Dark].xaml —— 随主题整份切换。

        页签 DataContext 就是 LayoutContent(LayoutDocument / LayoutAnchorable),
        故可直接绑定 Title / IsSelected / IsActive / CanClose;关闭命令走
        TemplatedParent 的 LayoutItem.CloseCommand。(经运行期探针确认)
    -->

    <!-- ================================================================ 页签(UI-06) -->

    <!--
        同心圆角:卡片外圆角 8,页签条相对卡片内缩 3,故页签上圆角取 5。
        主窗体不再使用横跨整窗的 CaptionHeight 命中区；中央文档页签行的空白
        由 ShellWindow 单独接管拖动，工具窗格顶部因此始终保持可操作。
    -->
    <ControlTemplate x:Key="Shell.Docking.TabItemTemplate" TargetType="{x:Type Control}">
        <Border x:Name="Bd"
                Margin="0,0,2,0"
                Background="Transparent"
                CornerRadius="{DynamicResource Shell.Radius.TabTop}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText"
                           Grid.Column="0"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource Shell.Font.Family}"
                           FontSize="{DynamicResource Shell.Font.Body}"
                           Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                           Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Title}" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Width="18" Height="18"
                        Margin="6,0,6,0"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        Focusable="False"
                        Visibility="Collapsed"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Command="{Binding LayoutItem.CloseCommand,
                                  RelativeSource={RelativeSource TemplatedParent}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="CloseBd" Background="{TemplateBinding Background}"
                                    CornerRadius="4">
                                <Path Data="M 0,0 L 7,7 M 7,0 L 0,7"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Stroke="{DynamicResource Shell.Brush.TextSecondary}"
                                      StrokeThickness="1.1" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBd" Property="Background"
                                            Value="{DynamicResource Shell.Brush.SurfacePressed}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Shell.Brush.SurfaceHover}" />
            </Trigger>
            <DataTrigger Binding="{Binding CanClose}" Value="True">
                <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
            </DataTrigger>
            <!-- The outer TabItem is the visual selection source of truth. -->
            <DataTrigger Binding="{Binding IsSelected,
                                      RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}"
                         Value="True">
                <Setter TargetName="Bd" Property="Background"
                        Value="{DynamicResource Shell.Brush.AccentSoft}" />
                <Setter TargetName="TitleText" Property="Foreground"
                        Value="{DynamicResource Shell.Brush.TextPrimary}" />
                <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--
        窗格控件是 TabControl,页签容器因此是普通 TabItem;AvalonDock 的
        LayoutDocumentTabItem / LayoutAnchorableTabItem 是容器模板里承担
        拖拽、激活、上下文菜单的那一层。所以外层样式必须 TargetType=TabItem,
        内层才换我们的视觉模板 —— 直接给容器套 LayoutXxxTabItem 样式会抛
        「样式不适用于类型 TabItem」。
    -->
    <Style x:Key="Shell.Docking.DocumentTabItemStyle" TargetType="{x:Type adc:LayoutDocumentTabItem}">
        <Setter Property="Height" Value="{DynamicResource Shell.Size.Tab}" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="MaxWidth" Value="220" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template" Value="{StaticResource Shell.Docking.TabItemTemplate}" />
    </Style>

    <Style x:Key="Shell.Docking.AnchorableTabItemStyle" TargetType="{x:Type adc:LayoutAnchorableTabItem}">
        <Setter Property="Height" Value="{DynamicResource Shell.Size.Tab}" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="MaxWidth" Value="220" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template" Value="{StaticResource Shell.Docking.TabItemTemplate}" />
    </Style>

    <Style x:Key="Shell.Docking.DocumentTabContainerStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <adc:LayoutDocumentTabItem Model="{Binding}"
                                               Style="{StaticResource Shell.Docking.DocumentTabItemStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Shell.Docking.AnchorableTabContainerStyle" TargetType="{x:Type TabItem}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <adc:LayoutAnchorableTabItem Model="{Binding}"
                                                 Style="{StaticResource Shell.Docking.AnchorableTabItemStyle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 工具页动作(R3-1) -->

    <!--
        3.1 第三轮:工具页原本自带一条「蓝条」标题栏(标题 + 虚线拖拽区 + ▼📌✕),
        与页签行重复且抢眼。现在整条取消,三个动作缩成页面右上角的一组浅色小图标,
        常态半透明、悬停才实体化。命令仍取自 AvalonDock 的 LayoutItem,功能不减:
        ▼ 浮动 / 停靠为文档 / 自动隐藏 / 隐藏,📌 自动隐藏,✕ 隐藏。
    -->
    <Style x:Key="Shell.Docking.PaneActionButton" TargetType="ButtonBase">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="1,0,0,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Shell.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        R4-1:动作图标不再浮在内容上方(会盖住视图自己的工具条),改为占据
        页签行右端的一个固定位置 —— 与页签同排、同高,像最后一个「标签」。
        R4-2:📌 自动隐藏单独成键已取消,该动作在 ▼ 菜单里仍在。
    -->
    <Style TargetType="{x:Type adc:AnchorablePaneTitle}">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type adc:AnchorablePaneTitle}">
                    <StackPanel x:Name="Actions"
                                Margin="4,0,2,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Opacity="0.55"
                                Orientation="Horizontal">
                        <Button x:Name="RestoreFocus"
                                Style="{StaticResource Shell.Docking.PaneActionButton}"
                                ToolTip="恢复页面"
                                Visibility="Collapsed"
                                Command="{DynamicResource Shell.Command.PageAction}"
                                CommandParameter="restore"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Path Data="{DynamicResource Shell.Icon.ExitFocus}"
                                  Stroke="{DynamicResource Shell.Brush.TextSecondary}"
                                  StrokeThickness="1.1" />
                        </Button>
                        <ToggleButton x:Name="MenuToggle"
                                      Style="{StaticResource Shell.Docking.PaneActionButton}"
                                      ToolTip="页面操作">
                            <Path Data="M 0 0 L 4 4 L 8 0"
                                  Stroke="{DynamicResource Shell.Brush.TextSecondary}"
                                  StrokeThickness="1.3" />
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=MenuToggle, Mode=TwoWay}"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=MenuToggle}"
                               StaysOpen="False">
                            <Border Margin="0,2,10,10"
                                    Background="{DynamicResource Shell.Brush.Surface}"
                                    BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Shell.Radius.Inner}"
                                    Effect="{DynamicResource Shell.Shadow.Flyout}"
                                    Padding="4">
                                <StackPanel MinWidth="140">
                                    <MenuItem Header="浮动"
                                              Command="{DynamicResource Shell.Command.PageAction}"
                                              CommandParameter="float"
                                              CommandTarget="{Binding PlacementTarget,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" />
                                    <MenuItem Header="停靠为文档"
                                              Command="{DynamicResource Shell.Command.PageAction}"
                                              CommandParameter="dock-document"
                                              CommandTarget="{Binding PlacementTarget,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" />
                                    <MenuItem Header="自动隐藏"
                                              Command="{DynamicResource Shell.Command.PageAction}"
                                              CommandParameter="autohide"
                                              CommandTarget="{Binding PlacementTarget,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" />
                                    <MenuItem Header="隐藏"
                                              Command="{DynamicResource Shell.Command.PageAction}"
                                              CommandParameter="hide"
                                              CommandTarget="{Binding PlacementTarget,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Popup}}}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                        <Button Style="{StaticResource Shell.Docking.PaneActionButton}"
                                ToolTip="隐藏"
                                Command="{DynamicResource Shell.Command.PageAction}"
                                CommandParameter="hide"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8"
                                  Stroke="{DynamicResource Shell.Brush.TextSecondary}"
                                  StrokeThickness="1.2" />
                        </Button>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Actions" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Actions" Property="Opacity" Value="1" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Tag,
                                                  RelativeSource={RelativeSource AncestorType={x:Type Grid}}}"
                                     Value="FocusedShellPaneHeader">
                            <Setter TargetName="RestoreFocus" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        工具页内容宿主:原模板是「标题条 + 内容」两段,标题条就是那条蓝条。
        改成内容铺满、动作图标浮在右上角(不占布局位置)。
    -->
    <Style TargetType="{x:Type adc:LayoutAnchorableControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type adc:LayoutAnchorableControl}">
                    <!-- 内容铺满:标题条已取消,动作图标搬到窗格模板的页签行里(R4-1) -->
                    <ContentPresenter Content="{Binding Model.Content,
                                      RelativeSource={RelativeSource TemplatedParent}}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 拖拽分隔条(UI-01.2) -->

    <Style TargetType="{x:Type adc:LayoutGridResizerControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type adc:LayoutGridResizerControl}">
                    <Grid Background="Transparent">
                        <Border x:Name="Hint"
                                Margin="2"
                                Background="{DynamicResource Shell.Brush.Accent}"
                                CornerRadius="1"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hint" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 窗格模板:卡片形态 -->

    <!--
        W-04 沿用:标签条置顶。UI-01:窗格 = 圆角卡片 + 投影 + 外缘间隙。
        透明底层 Border 必须保留 —— 拖拽停靠依赖它捕获鼠标事件。
        中央文档模板自带 ShellChromeHost，ShellWindow 会把窗口控制栏挂到该宿主；
        工具窗格不再为主窗口按钮组预留右边距，避免小窗动作栏与窗口控制栏重叠。
    -->
    <ControlTemplate x:Key="Shell.Docking.AnchorablePaneTemplate"
                     TargetType="{x:Type adc:LayoutAnchorablePaneControl}">
        <Border Margin="{DynamicResource Shell.Space.Gap}"
                Background="{DynamicResource Shell.Brush.Surface}"
                CornerRadius="{DynamicResource Shell.Radius.Inner}"
                Effect="{DynamicResource Shell.Shadow.Card}"
                SnapsToDevicePixels="True">
            <Grid ClipToBounds="True"
                  KeyboardNavigation.TabNavigation="Local"
                  SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Background="Transparent" />
                <!-- 工具窗格动作栏独立占据页签行右端，不承载主窗口控制栏。 -->
                <Grid Grid.Row="0"
                      Panel.ZIndex="1"
                      Background="Transparent"
                      Margin="{DynamicResource Shell.Space.TabStrip}"
                      Tag="ShellPaneHeader">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <adc:AnchorablePaneTabPanel x:Name="HeaderPanel"
                                                Grid.Column="0"
                                                IsItemsHost="True"
                                                FlowDirection="LeftToRight"
                                                KeyboardNavigation.TabIndex="1" />
                    <!-- R4-1:页面动作与页签同排,占页签行右端的固定位置 -->
                    <adc:AnchorablePaneTitle Grid.Column="1"
                                             Model="{Binding SelectedItem,
                                                     RelativeSource={RelativeSource TemplatedParent}}" />
                </Grid>
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Grid.Row="1"
                                  Margin="{TemplateBinding Padding}"
                                  Content="{TemplateBinding SelectedContent}"
                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                  ContentSource="SelectedContent"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  KeyboardNavigation.TabIndex="2"
                                  KeyboardNavigation.TabNavigation="Cycle"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Grid>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="Shell.Docking.DocumentPaneTemplate"
                     TargetType="{x:Type adc:LayoutDocumentPaneControl}">
        <Border Margin="{DynamicResource Shell.Space.Gap}"
                Background="{DynamicResource Shell.Brush.Surface}"
                CornerRadius="{DynamicResource Shell.Radius.Inner}"
                Effect="{DynamicResource Shell.Shadow.Card}"
                SnapsToDevicePixels="True">
            <Grid ClipToBounds="True"
                  KeyboardNavigation.TabNavigation="Local"
                  SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.RowSpan="2" Background="Transparent" />
                <!-- REQ-DOCK-001:中央区页面选择区,单页时同样可见 -->
                <Grid Grid.Row="0"
                      Panel.ZIndex="1"
                      Background="Transparent"
                      Margin="{DynamicResource Shell.Space.TabStrip}"
                      Tag="ShellPaneHeader">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <adc:DocumentPaneTabPanel x:Name="HeaderPanel"
                                               Grid.Column="0"
                                               IsItemsHost="True"
                                               KeyboardNavigation.TabIndex="1" />
                    <!--
                        窗口控制栏只属于中央主窗口。ShellWindow 在布局稳定后把
                        ChromeBar 放入这个宿主，工具窗格不会再与它重叠。
                    -->
                    <Grid Grid.Column="1">
                        <ContentControl x:Name="ShellChromeHost"
                                        Tag="ShellChromeHost"
                                        Height="{DynamicResource Shell.Size.Tab}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Panel.ZIndex="2" />
                        <Button x:Name="FloatingDocumentMaxRestore"
                                Style="{StaticResource Shell.Docking.PaneActionButton}"
                                ToolTip="浮窗最大化/还原"
                                Visibility="Collapsed"
                                Tag="FloatingMaxRestore"
                                Command="{DynamicResource Shell.Command.PageAction}"
                                CommandParameter="toggle-floating"
                                CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Path x:Name="FloatingDocumentMaxRestoreIcon"
                                  Data="{DynamicResource Shell.Icon.Maximize}"
                                  Stroke="{DynamicResource Shell.Brush.TextSecondary}"
                                  StrokeThickness="1.1" />
                        </Button>
                    </Grid>
                </Grid>
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Grid.Row="1"
                                  Margin="{TemplateBinding Padding}"
                                  Content="{TemplateBinding SelectedContent}"
                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                  ContentSource="SelectedContent"
                                  KeyboardNavigation.DirectionalNavigation="Contained"
                                  KeyboardNavigation.TabIndex="2"
                                  KeyboardNavigation.TabNavigation="Cycle"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            </Grid>
        </Border>
    </ControlTemplate>

    <!-- ================================================================ 窗格模板:专注形态(UI-04) -->

    <ControlTemplate x:Key="Shell.Docking.AnchorablePaneTemplate.Chromeless"
                     TargetType="{x:Type adc:LayoutAnchorablePaneControl}">
        <Grid Background="{DynamicResource Shell.Brush.Surface}"
              ClipToBounds="True"
              KeyboardNavigation.TabNavigation="Local"
              SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="ShellToolChrome"
                  Grid.Row="0"
                  Height="{DynamicResource Shell.Size.Tab}"
                  Panel.ZIndex="1"
                  Background="Transparent"
                  Margin="{DynamicResource Shell.Space.TabStrip}"
                  Tag="FocusedShellPaneHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <adc:AnchorablePaneTabPanel x:Name="HeaderPanel"
                                            Grid.Column="0"
                                            IsItemsHost="True"
                                            FlowDirection="LeftToRight"
                                            KeyboardNavigation.TabIndex="1" />
                <!-- 聚焦态右侧只承载主窗口 ChromeBar；工具页动作不占位。 -->
                <ContentControl x:Name="FocusedShellChromeHost"
                                Grid.Column="1"
                                Tag="FocusedShellChromeHost"
                                Height="{DynamicResource Shell.Size.Tab}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="2" />
            </Grid>
            <ContentPresenter x:Name="PART_SelectedContentHost"
                              Grid.Row="1"
                              Margin="0"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                              ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                              ContentSource="SelectedContent"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Cycle"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
    </ControlTemplate>

    <!-- Keep AvalonDock's FloatingWindowContentHost and remove only its outer title row. -->
    <Style TargetType="{x:Type adc:LayoutAnchorableFloatingWindowControl}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Shell.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Brush.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="0"
                              ResizeBorderThickness="6"
                              GlassFrameThickness="0"
                              CornerRadius="0"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type adc:LayoutAnchorableFloatingWindowControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter DataContext="{x:Null}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type adc:LayoutDocumentFloatingWindowControl}">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Shell.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Brush.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="0"
                              ResizeBorderThickness="6"
                              GlassFrameThickness="0"
                              CornerRadius="0"
                              UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type adc:LayoutDocumentFloatingWindowControl}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter DataContext="{x:Null}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Shell.Docking.DocumentPaneTemplate.Chromeless"
                     TargetType="{x:Type adc:LayoutDocumentPaneControl}">
        <Grid Background="{DynamicResource Shell.Brush.Surface}"
              ClipToBounds="True"
              KeyboardNavigation.TabNavigation="Local"
              SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Height="{DynamicResource Shell.Size.Tab}"
                  Panel.ZIndex="1"
                  Background="Transparent"
                  Margin="{DynamicResource Shell.Space.TabStrip}"
                  Tag="FocusedShellPaneHeader">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <adc:DocumentPaneTabPanel x:Name="HeaderPanel"
                                          Grid.Column="0"
                                          IsItemsHost="True"
                                          KeyboardNavigation.TabIndex="1" />
                <!-- 聚焦态右侧与工具页共用主窗口 ChromeBar。 -->
                <ContentControl x:Name="FocusedShellChromeHost"
                                Grid.Column="1"
                                Tag="FocusedShellChromeHost"
                                Height="{DynamicResource Shell.Size.Tab}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Panel.ZIndex="2" />
            </Grid>
            <ContentPresenter x:Name="PART_SelectedContentHost"
                              Grid.Row="1"
                              Content="{TemplateBinding SelectedContent}"
                              ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                              ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                              ContentSource="SelectedContent"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabNavigation="Cycle"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
    </ControlTemplate>

</ResourceDictionary>
