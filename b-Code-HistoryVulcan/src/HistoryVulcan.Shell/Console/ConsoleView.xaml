<UserControl x:Class="HistoryVulcan.Shell.Console.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HistoryVulcan.Shell.Console"
             xmlns:logging="clr-namespace:HistoryVulcan.Core.Logging;assembly=HistoryVulcan.Core"
             Background="Transparent">

    <!--
        UI-07:底色交给窗格卡片(Background=Transparent),视图内部不再画分隔线,
        工具条与输入行改为 SurfaceAlt 圆角块,用留白代替线条。
    -->

    <UserControl.Resources>
        <ResourceDictionary>
            <!--
                视图是独立 BAML,加载时还没进入窗体资源域:StaticResource(含 BasedOn)
                必须在自己的作用域里找得到,所以控件字典要在这里再合并一次
                (WPF 按 Uri 缓存已解析的字典,重复合并不重复解析)。
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HistoryVulcan.Shell;component/Themes/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ToolText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="10,0,4,0" />
                <Setter Property="FontSize" Value="{DynamicResource Shell.Font.Small}" />
                <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.TextSecondary}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="10,8,10,10">
        <!--
            过滤器工具条(C-04 / C-07)。3.1 修订:整条是一个圆角矩形,
            内部用发丝线切成 筛选 / 关键字 / 开关 / 动作 四段,
            段内控件不再各带边框 —— 顶部只剩一个形状。
        -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Shell.Segment.Bar}">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="级别" Style="{StaticResource Shell.Segment.Label}" />
                <ComboBox x:Name="LevelFilter" Width="76"
                          Style="{StaticResource Shell.Segment.ComboBox}"
                          SelectionChanged="OnLevelChanged" />
                <TextBlock Text="域" Style="{StaticResource Shell.Segment.Label}" />
                <ComboBox x:Name="DomainFilter" Width="112"
                          Style="{StaticResource Shell.Segment.ComboBox}"
                          SelectionChanged="OnSourceChanged" />
                <TextBlock Text="类" Style="{StaticResource Shell.Segment.Label}" />
                <ComboBox x:Name="ClassFilter" Width="96"
                          Style="{StaticResource Shell.Segment.ComboBox}"
                          SelectionChanged="OnClassChanged" />

                <Border Visibility="Collapsed" Style="{StaticResource Shell.Segment.Divider}" />

                <TextBlock Text="关键字" Visibility="Collapsed" Style="{StaticResource Shell.Segment.Label}" />
                <TextBox x:Name="KeywordFilter" Width="150" Visibility="Collapsed"
                         Style="{StaticResource Shell.Segment.TextBox}" />

                <Border Visibility="Collapsed" Style="{StaticResource Shell.Segment.Divider}" />

                <CheckBox x:Name="MuteLayout" Content="屏蔽 layout" Visibility="Collapsed"
                          Style="{StaticResource Shell.Segment.CheckBox}" />
                <CheckBox x:Name="AutoScroll" Content="自动滚动" IsChecked="True" Visibility="Collapsed"
                          Style="{StaticResource Shell.Segment.CheckBox}" />

                <Border Visibility="Collapsed" Style="{StaticResource Shell.Segment.Divider}" />

                <Button Content="清屏" Visibility="Collapsed" Style="{StaticResource Shell.Segment.Button}" Click="OnClearClick" />
                <Button Content="导出" Visibility="Collapsed" Style="{StaticResource Shell.Segment.Button}" Click="OnExportClick" />
            </WrapPanel>
        </Border>

        <!-- 指令输入区(C-10) -->
        <Border DockPanel.Dock="Bottom"
                Margin="0,8,0,0"
                Background="{DynamicResource Shell.Brush.SurfaceAlt}"
                CornerRadius="{DynamicResource Shell.Radius.Inner}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&gt;" Margin="12,0,6,0"
                           VerticalAlignment="Center"
                           FontFamily="{DynamicResource Shell.Font.MonoFamily}"
                           FontSize="{DynamicResource Shell.Font.Body}"
                           Foreground="{DynamicResource Shell.Brush.Accent}"
                           FontWeight="Bold" />
                <TextBox x:Name="Input"
                         Background="Transparent" BorderThickness="0"
                         Padding="0,6" Margin="0,0,8,0"
                         FontFamily="{DynamicResource Shell.Font.MonoFamily}"
                         FontSize="{DynamicResource Shell.Font.Body}"
                         Foreground="{DynamicResource Shell.Brush.TextPrimary}"
                         SelectionBrush="{DynamicResource Shell.Brush.Accent}"
                         CaretBrush="{DynamicResource Shell.Brush.TextPrimary}"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="OnInputKeyDown" TextChanged="OnInputTextChanged"
                         SelectionChanged="OnInputSelectionChanged"
                         LostKeyboardFocus="OnInputLostKeyboardFocus"
                         SizeChanged="OnInputSizeChanged" />
            </DockPanel>
        </Border>

        <!-- 输出区:虚拟化列表(C-05 / N-03) -->
        <Popup x:Name="CompletionPopup"
               PlacementTarget="{Binding ElementName=Input}"
               Placement="Top"
               VerticalOffset="-6"
               AllowsTransparency="True"
               Focusable="False"
               StaysOpen="True"
               PopupAnimation="Fade">
            <Border x:Name="CompletionBorder"
                    Width="360"
                    MaxHeight="240"
                    Background="{DynamicResource Shell.Brush.Surface}"
                    BorderBrush="{DynamicResource Shell.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource Shell.Radius.Inner}"
                    Padding="4">
                <ListBox x:Name="CompletionList"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource Shell.Brush.TextPrimary}"
                         IsHitTestVisible="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DisplayText}"
                                           FontFamily="{DynamicResource Shell.Font.MonoFamily}"
                                           FontSize="{DynamicResource Shell.Font.Body}"
                                           Foreground="{DynamicResource Shell.Brush.TextPrimary}" />
                                <TextBlock Grid.Column="1"
                                           Margin="12,0,0,0"
                                           Text="{Binding Description}"
                                           TextTrimming="CharacterEllipsis"
                                           FontSize="{DynamicResource Shell.Font.Small}"
                                           Foreground="{DynamicResource Shell.Brush.TextSecondary}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="CompletionItemBorder"
                                                Background="Transparent"
                                                CornerRadius="{DynamicResource Shell.Radius.Inner}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="CompletionItemBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource Shell.Brush.AccentSoft}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>
        </Popup>

        <ListBox x:Name="Output"
                 Margin="0,6,0,0"
                 Background="Transparent"
                 BorderThickness="0"
                 FontFamily="{DynamicResource Shell.Font.MonoFamily}"
                 FontSize="{DynamicResource Shell.Font.Mono}"
                 SelectionMode="Extended"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ConsoleRow}">
                    <TextBlock HorizontalAlignment="Stretch"
                               Text="{Binding Text}"
                               TextWrapping="Wrap">
                        <!--
                            ConsoleRow.Foreground 保留为公开兼容属性，但渲染颜色由当前
                            主题令牌统一决定，避免深色主题继续使用浅色硬编码画刷。
                        -->
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.TextPrimary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:ShellLogLevel.Trace}">
                                        <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.TextDisabled}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:ShellLogLevel.Debug}">
                                        <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.TextSecondary}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:ShellLogLevel.Warn}">
                                        <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.Warning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:ShellLogLevel.Error}">
                                        <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.Danger}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Level}" Value="{x:Static logging:ShellLogLevel.Fatal}">
                                        <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <!--
                    UI-09.4:承压路径(debug.logflood)上的容器样式保持极简,
                    不加投影、不加动画,行高与 3.0.3 一致。
                -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,0" />
                    <Setter Property="MinHeight" Value="16" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="SnapsToDevicePixels" Value="True" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="{DynamicResource Shell.Radius.Inner}"
                                        Padding="{TemplateBinding Padding}"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter Content="{TemplateBinding Content}"
                                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource Shell.Brush.SurfaceHover}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background"
                                                Value="{DynamicResource Shell.Brush.AccentSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制所选" Click="OnCopyClick" />
                    <MenuItem Header="清屏 (cls)" Click="OnClearClick" />
                    <MenuItem Header="导出可见内容…" Click="OnExportClick" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </DockPanel>
</UserControl>
