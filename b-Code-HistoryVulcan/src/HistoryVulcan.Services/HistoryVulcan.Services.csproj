<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HistoryVulcan.Services</RootNamespace>
    <PackageId>OneHistory.HistoryVulcan.Services</PackageId>
    <Title>OneHistory HistoryVulcan Services</Title>
    <Description>Settings, logging, file-backed state, module hosting, and MCP services for OneHistory HistoryVulcan.</Description>
    <PackageTags>onehistory;HistoryVulcan;storage;modules;mcp</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HistoryVulcan.Core\HistoryVulcan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
  </ItemGroup>

</Project>
