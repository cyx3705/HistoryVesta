  11          #define BUF_SIZE    64            // 单帧最大长度，可根据需求增大
  12          
  13          unsigned char recv_buf[BUF_SIZE];  // 接收缓冲区
  14          unsigned char recv_cnt = 0;        // 接收计数
  15          
  16          void UART_Init(void);
  17          void Send_Byte(unsigned char dat);
  18          void Send_Str(const char *str);
  19          void Send_Buf(unsigned char *buf, unsigned char len);
