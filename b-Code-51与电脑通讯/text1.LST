   1          // STC8A8K64D4 串口协议处理程序
   2          // 通信规则：数据以 ### 结尾，收到完整帧再转发
   3          // 时钟：11.064MHz  波特率：9600 8N1
   4          #include <reg51.h>
   5          
   6          sfr AUXR  = 0x8E;
   7          sfr P_SW1 = 0xA2;
