  26   1          Send_Str("格式：内容 + ### 结束\r\n\r\n");
  27   1      
  28   1          while(1)
  29   1          {
  30   2              if(RI)
  31   2              {
  32   3                  RI = 0;
  33   3                  if(recv_cnt < BUF_SIZE)
  34   3                  {
  35   4                      recv_buf[recv_cnt++] = SBUF;
  36   4      
  37   4                      // 检测结束标记 ###
  38   4                      if(recv_cnt >= 3 &&
  39   4                         recv_buf[recv_cnt-3] == '#' &&
  40   4                         recv_buf[recv_cnt-2] == '#' &&
  41   4                         recv_buf[recv_cnt-1] == '#')
  42   4                      {
  43   5                          recv_cnt -= 3;  // 去掉结束符
  44   5      
  45   5                          Send_Str("[收到完整帧] 长度=");
  46   5                          Send_Byte((recv_cnt / 10) + '0');
  47   5                          Send_Byte((recv_cnt % 10) + '0');
  48   5                          Send_Str(" 内容：");
  49   5                          Send_Buf(recv_buf, recv_cnt);
  50   5                          Send_Str("\r\n[转发完成]\r\n\r\n");
  51   5      
  52   5                          recv_cnt = 0;   // 清空缓冲区，准备下一帧
  53   5                      }
  54   4                  }
  55   3                  else
