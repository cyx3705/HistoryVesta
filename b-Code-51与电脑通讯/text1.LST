  75          void UART_Init(void)
  76          {
  77   1          P_SW1 &= ~0xC0;                // 固定映射到 P3.0(RXD) / P3.1(TXD)
  78   1          SCON  = 0x50;                  // 模式1，8位数据，允许接收
