<UserControl x:Class="AppShell.Shell.Console.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AppShell.Shell.Console"
             Background="White">
    <UserControl.Resources>
        <Style x:Key="ToolText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,4,0" />
            <Setter Property="Foreground" Value="#666" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- 过滤器工具条(C-04 / C-07) -->
        <Border DockPanel.Dock="Top" BorderBrush="#DDD" BorderThickness="0,0,0,1" Background="#F7F7F7">
            <StackPanel Orientation="Horizontal" Height="28">
                <TextBlock Text="级别" Style="{StaticResource ToolText}" />
                <ComboBox x:Name="LevelFilter" Width="70" VerticalAlignment="Center"
                          SelectionChanged="OnFilterChanged" />
                <TextBlock Text="来源" Style="{StaticResource ToolText}" />
                <ComboBox x:Name="SourceFilter" Width="80" VerticalAlignment="Center"
                          SelectionChanged="OnFilterChanged" />
                <TextBlock Text="关键字" Style="{StaticResource ToolText}" />
                <TextBox x:Name="KeywordFilter" Width="120" VerticalAlignment="Center"
                         TextChanged="OnFilterChanged" />
                <CheckBox x:Name="MuteLayout" Content="屏蔽 layout" VerticalAlignment="Center"
                          Margin="10,0,0,0" Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                <CheckBox x:Name="AutoScroll" Content="自动滚动" VerticalAlignment="Center"
                          Margin="10,0,0,0" IsChecked="True" />
                <Button Content="清屏" Margin="12,3,0,3" Padding="8,0" Click="OnClearClick" />
                <Button Content="导出" Margin="6,3,0,3" Padding="8,0" Click="OnExportClick" />
            </StackPanel>
        </Border>

        <!-- 指令输入区(C-10) -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#DDD" BorderThickness="0,1,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&gt;" Margin="8,0,4,0"
                           VerticalAlignment="Center" FontFamily="Consolas" FontSize="13"
                           Foreground="#0050A0" FontWeight="Bold" />
                <TextBox x:Name="Input" BorderThickness="0" Padding="0,5"
                         FontFamily="Consolas" FontSize="13"
                         VerticalContentAlignment="Center"
                         PreviewKeyDown="OnInputKeyDown" TextChanged="OnInputTextChanged" />
            </DockPanel>
        </Border>

        <!-- 输出区:虚拟化列表(C-05 / N-03) -->
        <ListBox x:Name="Output"
                 BorderThickness="0"
                 FontFamily="Consolas" FontSize="12"
                 SelectionMode="Extended"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:ConsoleRow}">
                    <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" />
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="6,0" />
                    <Setter Property="MinHeight" Value="16" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="复制所选" Click="OnCopyClick" />
                    <MenuItem Header="清屏 (cls)" Click="OnClearClick" />
                    <MenuItem Header="导出可见内容…" Click="OnExportClick" />
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
    </DockPanel>
</UserControl>
