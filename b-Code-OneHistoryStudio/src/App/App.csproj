<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OneHistoryStudio</RootNamespace>
    <AssemblyName>OneHistoryStudio</AssemblyName>
    <Product>OneHistoryStudio</Product>
    <Title>OneHistoryStudio</Title>
    <Version>2.4.0</Version>
    <AssemblyVersion>2.4.0.0</AssemblyVersion>
    <FileVersion>2.4.0.0</FileVersion>
    <InformationalVersion>2.4.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- N-01:每显示器 DPI 感知(Per-Monitor V2) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\b-Code-AppShell\src\AppShell.Core\AppShell.Core.csproj" />
    <ProjectReference Include="..\..\..\b-Code-AppShell\src\AppShell.Services\AppShell.Services.csproj" />
    <ProjectReference Include="..\..\..\b-Code-AppShell\src\AppShell.Shell\AppShell.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      V2.4.0 将产品文档上抛到 020 根级 b-Office/OHS；Link 一律保持 docs\，随程序发布的 Help 目录结构
      (Publish\docs\*.md) 是面向使用者的产品界面，不随源码目录调整而变。
    -->
    <Content Include="..\..\..\b-Office\OHS\meta\README.md" Link="docs\README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\b-Office\OHS\meta\命令手册.md" Link="docs\命令手册.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\b-Office\OHS\meta\MCP接入与安全.md" Link="docs\MCP接入与安全.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\b-Office\OHS\meta\项目库与备份.md" Link="docs\项目库与备份.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\b-Office\OHS\meta\模块开发手册.md" Link="docs\模块开发手册.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\b-Office\OHS\meta\发布与升级.md" Link="docs\发布与升级.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
