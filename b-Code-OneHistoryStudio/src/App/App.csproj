<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>OneHistoryStudio</RootNamespace>
    <AssemblyName>OneHistoryStudio</AssemblyName>
    <Product>OneHistoryStudio</Product>
    <Title>OneHistoryStudio</Title>
    <Version>2.3.1</Version>
    <AssemblyVersion>2.3.1.0</AssemblyVersion>
    <FileVersion>2.3.1.0</FileVersion>
    <InformationalVersion>2.3.1</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- N-01:每显示器 DPI 感知(Per-Monitor V2) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AppShell.Core\AppShell.Core.csproj" />
    <ProjectReference Include="..\AppShell.Services\AppShell.Services.csproj" />
    <ProjectReference Include="..\AppShell.Shell\AppShell.Shell.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\docs\README.md" Link="docs\README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\命令手册.md" Link="docs\命令手册.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\MCP接入与安全.md" Link="docs\MCP接入与安全.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\项目库与备份.md" Link="docs\项目库与备份.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\模块开发手册.md" Link="docs\模块开发手册.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\docs\发布与升级.md" Link="docs\发布与升级.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
