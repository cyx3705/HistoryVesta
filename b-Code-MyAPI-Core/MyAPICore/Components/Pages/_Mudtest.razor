@page "/mudtest"
@rendermode RenderMode.InteractiveServer

@using MudBlazor

<PageTitle>MudBlazor 样式测试</PageTitle>

<h1>MudBlazor 样式测试页面</h1>
<p>如果下面按钮显示为蓝色 Material Design 样式，则 MudBlazor 已成功加载。</p>

<div style="margin: 30px 0; padding: 20px; border: 1px solid #ddd; background: #f9f9f9;">

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">
        主要按钮 (Primary)
    </MudButton>

    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Large" style="margin-left: 20px;">
        轮廓按钮 (Secondary)
    </MudButton>

    <MudButton Variant="Variant.Text" Color="Color.Success" Size="Size.Large" style="margin-left: 20px;">
        文本按钮 (Success)
    </MudButton>

    <br /><br />

    <MudText Typo="Typo.h4" Color="Color.Info">这是一段 MudText 测试文字</MudText>

    <MudCard style="margin-top: 30px; max-width: 400px;">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h5">MudCard 测试</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudText>如果这个卡片有阴影和圆角，说明样式正常。</MudText>
        </MudCardContent>
        <MudCardActions>
            <MudButton Color="Color.Primary">确认</MudButton>
        </MudCardActions>
    </MudCard>

</div>

@code {
}