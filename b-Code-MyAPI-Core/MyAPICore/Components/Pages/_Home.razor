@page "/"
@using MudBlazor
@using BaseVariable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8">

    <!-- 1. Hero 区 -->
    <MudText Typo="Typo.h3" Class="mb-4" Color="Color.Primary">欢迎使用 MyAPI Core</MudText>
    <MudText Typo="Typo.h6" Class="mb-8 text-muted">一个基于 .NET 的动态指令可视化管理平台</MudText>

    <!-- 2. 架构概览 -->
    <MudText Typo="Typo.h5" Class="mb-6">系统架构</MudText>
    <MudGrid Spacing="4" Class="mb-10">
        <MudItem xs="12" md="4">
            <MudCard>
                <MudCardHeader>
                    <MudText Typo="Typo.h6">前端</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudText>Blazor Server + MudBlazor</MudText>
                    <MudText Class="text-muted">可视化操作面板</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard>
                <MudCardHeader>
                    <MudText Typo="Typo.h6">后端</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudText>ASP.NET Core + 动态模块加载</MudText>
                    <MudText Class="text-muted">反射生成 HTTP 接口</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudCard>
                <MudCardHeader>
                    <MudText Typo="Typo.h6">核心特性</MudText>
                </MudCardHeader>
                <MudCardContent>
                    <MudText>动态指令集 + 可视化按钮面板</MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- 3. 动态接口列表（竖排单列） -->
    <MudText Typo="Typo.h5" Class="mb-6">当前可用动态接口</MudText>

    @if (isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        <MudText Class="mt-4 ml-2">正在从后端加载接口列表...</MudText>
    }
    else if (groupedEndpoints == null || !groupedEndpoints.Any())
    {
        <MudAlert Severity="Severity.Warning">暂无注册的动态接口</MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Success" Class="mb-6" Icon="@Icons.Material.Filled.CheckCircle">
            已成功注册 <strong>@totalEndpoints</strong> 个动态接口
        </MudAlert>

        <!-- 竖排单列布局 -->
        <MudStack Spacing="6">
            @foreach (var group in groupedEndpoints)
            {
                <MudCard Elevation="3">
                    <MudCardHeader>
                        <MudText Typo="Typo.h6" Color="Color.Primary">@group.Key</MudText>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudList T="DynamicEndpoint" Dense="true">
                            @foreach (var endpoint in group.Value)
                            {
                                <MudListItem>
                                    <div class="d-flex flex-column">
                                        <MudText Typo="Typo.body1" Class="font-weight-medium">
                                            <MudIcon Icon="@Icons.Material.Filled.Api" Class="mr-2" Color="Color.Info" />
                                            @endpoint.Method
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted mt-1">
                                            @endpoint.Description
                                        </MudText>
                                        <MudText Typo="Typo.caption" Class="text-muted">
                                            @endpoint.FullPath
                                        </MudText>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    </MudCardContent>
                    <MudCardActions Class="justify-end">
                        <MudChip T="string" Color="Color.Info" Size="Size.Small">
                            @group.Value.Count 个方法
                        </MudChip>
                    </MudCardActions>
                </MudCard>
            }
        </MudStack>
    }

    <!-- 4. 训练提示区 -->
    <MudText Typo="Typo.h5" Class="mt-12 mb-4">前端训练笔记</MudText>
    <MudPaper Class="pa-6">
        <MudText>
            当前使用 Blazor Server + MudBlazor 实现界面。<br>
            已完成动态接口从后端自动获取并展示，后续可继续练习：组件封装、状态管理、实时刷新等。
        </MudText>
    </MudPaper>

</MudContainer>

@code {
    private bool isLoading = true;
    private int totalEndpoints = 0;
    private Dictionary<string, List<DynamicEndpoint>> groupedEndpoints = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadEndpointsAsync();
    }

    private async Task LoadEndpointsAsync()
    {
        try
        {
            isLoading = true;

            string apiUrl = $"http://localhost:{BSV.mstPort}/api/meta/endpoints";

            var response = await BSV.httpClient.GetFromJsonAsync<EndpointResponse>(apiUrl);

            if (response?.Data != null)
            {
                totalEndpoints = response.Total;

                groupedEndpoints = response.Data
                    .GroupBy(e => $"{e.Namespace}.{e.Class}")
                    .ToDictionary(
                        g => g.Key,
                        g => g.OrderBy(e => e.Method).ToList()
                    );
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"加载接口列表失败: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    public class EndpointResponse
    {
        public bool Success { get; set; } = true;
        public int Total { get; set; }
        public List<DynamicEndpoint> Data { get; set; } = new();
    }

    public class DynamicEndpoint
    {
        public string Namespace { get; set; } = "";
        public string Class { get; set; } = "";
        public string Method { get; set; } = "";
        public string FullPath { get; set; } = "";
        public string Description { get; set; } = "";
        public DateTime RegisteredAt { get; set; }
    }
}