@page "/designer"
@rendermode InteractiveServer

@using MudBlazor
@inject IJSRuntime JS

<h3>可视化指令面板</h3>
<p>点击下方按钮添加操作节点 → 拖拽调整位置 → 右键配置指令</p>

<div style="margin-bottom: 15px;">
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="AddNewButton" Size="Size.Large">
        + 添加新操作按钮
    </MudButton>
</div>

<div id="canvas" class="designer-canvas"
     style="position: relative; width: 1300px; height: 800px; border: 3px dashed #666; background: #f8f9fa; margin: 0 auto; overflow: hidden;">

    @foreach (var btn in buttons)
    {
        @* 使用局部变量捕获循环项以确保闭包引用的正确性，并明确 lambda 表达式的参数类型以消除推断歧义 *@
        var currentBtn = btn;
        <DraggableButton Text="@btn.Text"
                         Left="@btn.Left"
                         Top="@btn.Top"
                         Id="@btn.Id"
                         PositionChanged="@(async ((double Left, double Top) pos) => await UpdateButtonPosition(currentBtn.Id, pos))" />
    }

</div>

@code {
    private List<DesignButton> buttons = new();

    protected override void OnInitialized()
    {
        buttons.Add(new DesignButton { Text = "拉取最新代码", Left = 150, Top = 100, Command = "git pull" });
        buttons.Add(new DesignButton { Text = "提交更改", Left = 400, Top = 150, Command = "git commit" });
    }

    private void AddNewButton()
    {
        var newBtn = new DesignButton
        {
            Id = $"btn{Guid.NewGuid().ToString("N").Substring(0, 8)}",
            Text = $"操作 {buttons.Count + 1}",
            Left = 100 + (buttons.Count % 6) * 160,
            Top = 100 + (buttons.Count / 6) * 100
        };
        buttons.Add(newBtn);
        StateHasChanged();
    }

    private async Task UpdateButtonPosition(string id, (double Left, double Top) pos)
    {
        var btn = buttons.FirstOrDefault(b => b.Id == id);
        if (btn != null)
        {
            btn.Left = pos.Left;
            btn.Top = pos.Top;
        }
    }

    // 数据模型
    public class DesignButton
    {
        public string Id { get; set; } = "";
        public string Text { get; set; } = "新按钮";
        public double Left { get; set; }
        public double Top { get; set; }
        public string Command { get; set; } = "";
        public string Description { get; set; } = "";
    }
}