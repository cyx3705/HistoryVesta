@page "/cmd"

@using CmdModule
@using BaseVariable
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using System.Text
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime
@inject CmdModule.CmdMain _cmdMain

<div style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; margin: 0; padding: 0; background: #000000; color: #00ff9d; font-family: 'Courier New', Consolas, monospace; font-size: 18px; overflow: hidden; display: flex; flex-direction: column; z-index: 9999;">

    <div id="logArea"
         style="flex: 1; padding: 20px 25px; overflow-y: auto; white-space: pre-wrap; line-height: 1.65; background: #000000; color: #00ff9d;">
        @logText
    </div>

    <div style="background: #000000; padding: 12px 25px; display: flex; align-items: center; border-top: 1px solid #00ff9d;">
        <span style="color: #00ff9d; margin-right: 12px;">&gt;</span>
        <input @bind="commandInput"
               @onkeydown="HandleKeyPress"
               placeholder="输入命令后按 Enter 执行"
               style="flex: 1; background: transparent; border: none; outline: none; color: #00ff9d; font-family: 'Courier New', Consolas, monospace; font-size: 18px;" />
    </div>
</div>

@code {
    private string logText = "";
    private string commandInput = "";

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(300);

        // 加载历史所有日志（支持刷新页面后恢复）
        var history = ConsoleLogBuffer.GetAllLogs();
        logText = string.Join("\n", history) + "\n";

        // 订阅新日志事件（多页面同步关键）
        ConsoleLogBuffer.OnNewLog += OnNewLogReceived;
    }

    // 新日志到来时追加（所有页面都会收到）
    private void OnNewLogReceived(string newLog)
    {
        InvokeAsync(async () =>
        {
            logText = (logText ?? "") + newLog + "\n";   // 安全处理
            StateHasChanged();
            await ScrollToBottom();
        });
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval",
                "document.getElementById('logArea').scrollTop = document.getElementById('logArea').scrollHeight");
        }
        catch { }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(commandInput))
            return;

        string cmd = commandInput.Trim();
        commandInput = "";

        // 回显命令
        logText += $"> {cmd}\n";
        await InvokeAsync(StateHasChanged);

        // 执行命令
        await ExecuteCommand(cmd);
    }

    /// <summary>
    /// 使用 GET 方式调用 Execute（绕过 JSON 解析问题）
    /// </summary>
    private async Task ExecuteCommand(string command)
    {
        if (string.IsNullOrWhiteSpace(command)) return;

        // 把命令作为查询参数传递
        string fullUrl = $"http://localhost:{BSV.mstPort}/api/CmdModule/CmdApi/Execute?command={Uri.EscapeDataString(command)}";

        try
        {
            Console.WriteLine($"[网页控制台] 准备发送命令: {command}");
            Console.WriteLine($"[网页控制台] 请求地址(GET): {fullUrl}");

            var response = await BSV.httpClient.GetAsync(fullUrl);

            Console.WriteLine($"[网页控制台] 响应状态码: {(int)response.StatusCode} {response.StatusCode}");

            string responseText = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"[网页控制台] 返回内容: {responseText}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[网页控制台] 请求异常: {ex.Message}");
            if (ex.InnerException != null)
                Console.WriteLine($"InnerException: {ex.InnerException.Message}");
        }
    }

    public void Dispose()
    {
        ConsoleLogBuffer.OnNewLog -= OnNewLogReceived;   // 取消订阅，防止内存泄漏
    }
}