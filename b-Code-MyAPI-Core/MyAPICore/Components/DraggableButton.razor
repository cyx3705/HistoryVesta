@using MudBlazor

<div id="@Id"
     style="position: absolute; left: @(Left)px; top: @(Top)px; cursor: move; z-index: 100;"
     @oncontextmenu="OnContextMenu"
     @oncontextmenu:preventDefault="true">

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">
        @Text
    </MudButton>
</div>

@code {
    [Parameter] public string Text { get; set; } = "按钮";
    [Parameter] public double Left { get; set; } = 400;
    [Parameter] public double Top { get; set; } = 200;
    [Parameter] public string Id { get; set; } = "btn1";

    // 关键：必须有这个参数
    [Parameter] public EventCallback<(double Left, double Top)> PositionChanged { get; set; }

    private void OnContextMenu(MouseEventArgs e)
    {
        Console.WriteLine($"右键点击了按钮: {Text}");
    }
}