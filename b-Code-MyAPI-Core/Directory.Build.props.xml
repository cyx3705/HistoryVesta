<Project>

	<!-- ==================== 基础路径定义 ==================== -->
	<PropertyGroup>
		<MyAPI_Root>C:\MyAPI</MyAPI_Root>
		<ExternalDir>$(MyAPI_Root)\External</ExternalDir>
		<MST_Dir>$(ExternalDir)\MST</MST_Dir>
		<AST_Dir>$(ExternalDir)\AST</AST_Dir>
	</PropertyGroup>

	<!-- ==================== 内部 .NET Core 项目统一输出到 MST ==================== -->
	<PropertyGroup Condition="'$(MSBuildProjectName)' == 'CmdModule' OR 
                            '$(MSBuildProjectName)' == 'QuartzModule' OR 
                            '$(MSBuildProjectName)' == 'ManagerModule' OR 
                            '$(MSBuildProjectName)' == 'UpdateModule' OR 
                            '$(MSBuildProjectName)' == 'MyUtilsModule'">
		<OutputPath>$(MST_Dir)\</OutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
	</PropertyGroup>

	<!-- ==================== Post-Build 自动复制（内部项目） ==================== -->
	<Target Name="CopyToMST" AfterTargets="Build"
			Condition="'$(MSBuildProjectName)' == 'CmdModule' OR 
                     '$(MSBuildProjectName)' == 'QuartzModule' OR 
                     '$(MSBuildProjectName)' == 'ManagerModule' OR 
                     '$(MSBuildProjectName)' == 'UpdateModule'">
		<Copy SourceFiles="$(TargetPath)"
			  DestinationFolder="$(MST_Dir)\"
			  SkipUnchangedFiles="true" />

		<Copy SourceFiles="$(TargetDir)$(TargetName).pdb"
			  DestinationFolder="$(MST_Dir)\"
			  SkipUnchangedFiles="true"
			  Condition="Exists('$(TargetDir)$(TargetName).pdb')" />
	</Target>

</Project>
