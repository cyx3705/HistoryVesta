<Project>
  <!-- SWuse 唯一可编辑的发布版本源。 -->
  <PropertyGroup>
    <SWuseVersion>0.1.0</SWuseVersion>
    <Version>$(SWuseVersion)</Version>
    <AssemblyVersion>$(SWuseVersion).0</AssemblyVersion>
    <FileVersion>$(SWuseVersion).0</FileVersion>
    <InformationalVersion>$(SWuseVersion)</InformationalVersion>
  </PropertyGroup>
</Project>
