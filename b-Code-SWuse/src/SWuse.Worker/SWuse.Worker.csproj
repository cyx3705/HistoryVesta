<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\SWuse.Version.props" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SWuse.Worker</AssemblyName>
    <RootNamespace>SWuse.Worker</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
    <NoWarn>$(NoWarn);NU1801</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\SWuse.Api\SWuse.Api.csproj" />
    <ProjectReference Include="..\SWuse.Contracts\SWuse.Contracts.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
    <InternalsVisibleTo Include="SWuse.Smoke" />
  </ItemGroup>
</Project>
