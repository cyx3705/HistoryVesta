<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\build\SWuse.Version.props" />
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SWuse.Smoke" />
    <ProjectReference Include="..\SWuse.Api\SWuse.Api.csproj" />
    <ProjectReference Include="..\SWuse.Contracts\SWuse.Contracts.csproj" />
    <ProjectReference Include="..\SWuse.Worker\SWuse.Worker.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="OneHistory.AppShell.Core" Version="3.0.3" />
  </ItemGroup>
  <Target Name="CopyWorkerArtifacts" AfterTargets="Build">
    <ItemGroup>
      <WorkerArtifact Include="..\SWuse.Worker\bin\$(Configuration)\net8.0-windows\win-x64\*.dll" />
      <WorkerArtifact Include="..\SWuse.Worker\bin\$(Configuration)\net8.0-windows\win-x64\*.exe" />
      <WorkerArtifact Include="..\SWuse.Worker\bin\$(Configuration)\net8.0-windows\win-x64\*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerArtifact)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
