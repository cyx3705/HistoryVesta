<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Shell 统一主题基底:VS2013 浅色(S-04:浅色为默认,深色后置 P2)。
        标签条置顶(W-04)不在此处做 —— AvalonDock 的窗格样式经
        DockingManager.AnchorablePaneControlStyle 属性下发,主题字典中的
        隐式 Style 不会命中,见 ShellWindow 对该属性的覆写。
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AvalonDock.Themes.VS2013;component/LightTheme.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
