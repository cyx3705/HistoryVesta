<Project>

  <!--
    0.4.4 由 OneHistoryStudio V2.3.3 反哺:解决方案级公共构建属性。
    作用范围:本目录及其子目录的全部工程。
  -->

  <PropertyGroup>
    <!--
      运行时裁剪。
      Microsoft.Data.Sqlite → SQLitePCLRaw.lib.e_sqlite3 默认携带 20 个 RID 的原生库
      (browser-wasm / linux-mips64 / linux-s390x / maccatalyst / osx / win 等),
      每份构建输出中 runtimes\ 独占约 25M。本模板与其派生应用都是
      net8.0-windows + WPF 的 Windows 桌面程序,20 份里 19 份永远不会被加载。
      钉死 RID 后 runtimes\ 消失,win-x64 原生库以 e_sqlite3.dll 落在输出根,
      单份输出约 27M → 约 4M。

      禁止改用 AfterBuild 删除 runtimes\ 的做法:那样 deps.json 仍登记全部 RID,
      文件删了账没改,运行期探测行为不可预期。

      派生到非 x64 目标时,在派生侧的 Directory.Build.props 覆盖 RuntimeIdentifier 即可。
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>

    <!--
      指定 RID 后 SDK 默认把输出改到 bin\<配置>\<TFM>\win-x64\,
      会让既有脚本与文档里的输出路径引用一次性失效。固定回 bin\<配置>\<TFM>\。
    -->
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>

    <!--
      不设 SatelliteResourceLanguages:卫星资源共约 136K,其中 zh-Hans / zh-Hant 承载
      AvalonDock 的中文界面字符串,裁剪会改变停靠菜单等 UI 文本。收益不值这个风险。
    -->
  </PropertyGroup>

</Project>
