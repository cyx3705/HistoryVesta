<Window x:Class="OneHistoryGitTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:OneHistoryGitTool.Models"
        mc:Ignorable="d"
        Title="OneHistory - 分支与工作树管理工具 (测试版)" 
        Height="780" Width="860"
        WindowStartupLocation="CenterScreen"
        FontSize="14">

    <Window.Resources>
        <!-- 通用按钮样式 -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1976D2"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="SuccessButton" TargetType="Button">
            <Setter Property="Background" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="Background" Value="#C62828"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部标题栏 -->
        <Border Grid.Row="0" Background="#1E3A5F" Padding="12,8" CornerRadius="4" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="OneHistory" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <TextBlock Text="  项目分支工作树管理工具  v1.0" FontSize="14" Foreground="#A0C4E8" VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 主功能区域（四个页面） -->
        <TabControl Grid.Row="1" Margin="0,0,0,8" FontSize="14">
        <!-- ==================== 页面1：分支与工作树管理 ==================== -->
        <TabItem Header="分支与工作树管理">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题说明 -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="OneHistory 项目分支 &amp; 工作树管理工具" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="当前使用测试裸仓库：C:\OneHistory\OneHistory-Projects\OneHistory-Projects.git" 
                                   Foreground="#666" FontSize="12" Margin="0,4,0,0"/>
                        <TextBlock Text="功能：创建新分支+工作树  |  删除分支+工作树（含强警告确认）" 
                                   Foreground="#666" FontSize="12"/>
                    </StackPanel>

                    <!-- 配置区 -->
                    <GroupBox Grid.Row="1" Header="仓库配置" Margin="0,0,0,12" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="裸仓库路径：" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox x:Name="BareRepoPathBox" Grid.Row="0" Grid.Column="1" 
                                     Text="C:\OneHistory\OneHistory-Projects\OneHistory-Projects.git" Margin="0,0,0,6"/>

                            <TextBlock Text="工作树根目录：" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox x:Name="WorktreeRootBox" Grid.Row="1" Grid.Column="1" 
                                     Text="C:\OneHistory\OneHistory-Projects" Margin="0,0,0,6"/>

                            <TextBlock Text="基础分支：" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="BaseBranchBox" Grid.Row="2" Grid.Column="1" 
                                     Text="0000-000-Template"/>
                        </Grid>
                    </GroupBox>

                    <!-- 创建输入区 -->
                    <GroupBox Grid.Row="2" Header="创建新项目" Margin="0,0,0,12" Padding="10">
                        <StackPanel>
                            <TextBlock Text="项目名称（分支名 = 工作树文件夹名）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="ProjectNameBox" FontSize="18" Height="40" 
                                     TextChanged="ProjectNameBox_TextChanged"
                                     KeyDown="ProjectNameBox_KeyDown"/>
                            
                            <!-- 预览 -->
                            <TextBlock Text="预览路径：" Margin="0,10,0,4" Foreground="#555"/>
                            <TextBlock x:Name="PreviewPathText" FontFamily="Consolas" FontSize="13" 
                                       Foreground="#2E7D32" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            
                            <TextBlock x:Name="CommandPreviewText" FontFamily="Consolas" FontSize="12" 
                                       Foreground="#555" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 操作按钮 -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,12">
                        <Button x:Name="CreateButton" Content="创建分支 + 工作树" 
                                Width="220" Height="42" FontSize="16" FontWeight="Bold"
                                Style="{StaticResource PrimaryButton}"
                                Click="CreateButton_Click"/>
                        <Button x:Name="OpenFolderButton" Content="打开工作树文件夹" 
                                Width="140" Height="42" Margin="12,0,0,0"
                                IsEnabled="False"
                                Click="OpenFolderButton_Click"/>
                    </StackPanel>

                    <!-- 删除区域（危险操作） -->
                    <GroupBox Grid.Row="4" Header="删除分支与工作树（⚠ 危险操作）" Margin="0,0,0,12" Padding="10" BorderBrush="#C62828" BorderThickness="1.5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
                                <Button x:Name="RefreshWorktreesButton" Content="刷新工作树列表" 
                                        Width="140" Height="32" Click="RefreshWorktreesButton_Click"/>
                                <TextBlock Text="  选择要删除的项目（分支=工作树）" VerticalAlignment="Center" Foreground="#C62828" FontSize="13" Margin="12,0,0,0"/>
                                
                                <!-- 简单搜索框：只按编号前缀过滤 -->
                                <TextBlock Text="   搜索编号：" VerticalAlignment="Center" Margin="20,0,0,0" FontSize="12"/>
                                <TextBox x:Name="DeleteSearchBox" 
                                         Width="160" Height="26" 
                                         VerticalAlignment="Center"
                                         TextChanged="DeleteSearchBox_TextChanged"
                                         ToolTip="输入编号前缀，例如 2026，只显示以2026开头的分支"/>
                            </StackPanel>

                            <ListBox x:Name="WorktreesListBox" Grid.Row="1" Grid.ColumnSpan="2" 
                                     Height="110" Margin="0,0,0,8"
                                     SelectionChanged="WorktreesListBox_SelectionChanged"
                                     FontFamily="Consolas" FontSize="12"
                                     DisplayMemberPath="Display"/>

                            <TextBlock Text="选中项目：" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="SelectedBranchBox" Grid.Row="2" Grid.Column="1" 
                                     Width="320" IsReadOnly="True" Background="#FFF8F8" Foreground="#B71C1C"
                                     FontWeight="SemiBold"/>

                            <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="DeleteButton" Content="删除选中的分支 + 工作树" 
                                        Width="240" Height="36" FontWeight="Bold"
                                        Style="{StaticResource DangerButton}"
                                        IsEnabled="False"
                                        Click="DeleteButton_Click"/>
                                <TextBlock Text="  （会弹出强警告确认对话框）" VerticalAlignment="Center" Foreground="#666" FontSize="12" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- 底部状态（保留简短状态提示） -->
                    <Border Grid.Row="5" Background="#E3F2FD" Padding="8" Margin="0,8,0,0" CornerRadius="4">
                        <TextBlock x:Name="StatusText" Text="就绪 - 请输入项目名称或刷新工作树列表" Foreground="#1565C0"/>
                    </Border>
                </Grid>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 页面2：Git 操作继承树（核心新功能） ==================== -->
        <TabItem Header="Git 操作继承树">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 工具栏 + 路径提示 -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button x:Name="LoadTreeButton" Content="加载真实仓库继承树" 
                                Width="200" Height="38" FontSize="15" FontWeight="SemiBold"
                                Background="#2E7D32" Foreground="White"
                                Click="LoadTreeButton_Click"/>

                        <Button x:Name="ExpandAllButton" Content="全部展开" 
                                Width="90" Height="38" Margin="12,0,0,0"
                                Click="ExpandAllButton_Click"/>

                        <Button x:Name="CollapseAllButton" Content="全部折叠" 
                                Width="90" Height="38" Margin="8,0,0,0"
                                Click="CollapseAllButton_Click"/>
                    </StackPanel>

                    <TextBlock DockPanel.Dock="Right" 
                               Text="数据源：真实生产裸仓库 (OneHistory-Projects.git)"
                               Foreground="#666" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                    
                    <TextBlock x:Name="TreeStatusText" 
                               VerticalAlignment="Center" Margin="16,0,12,0"
                               Foreground="#2E7D32" FontSize="13" FontWeight="SemiBold"/>
                </DockPanel>

                <!-- TreeView 核心区域 -->
                <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA">
                    <TreeView x:Name="BranchTreeView"
                              Margin="4"
                              FontFamily="Segoe UI"
                              FontSize="13"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        
                        <!-- 关键：HierarchicalDataTemplate 支持无限层级 -->
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:BranchNode}" 
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Margin="1,3" MinWidth="380">
                                    <!-- 标题：分支名称（加粗醒目） -->
                                    <TextBlock Text="{Binding BranchName}" 
                                               FontWeight="SemiBold" 
                                               FontSize="13.5"
                                               Foreground="#1A237E">
                                        <TextBlock.ToolTip>
                                            <ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding BranchName}" FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="11" TextWrapping="Wrap" MaxWidth="500"/>
                                                    <TextBlock Text="{Binding LastPushTime}" FontSize="10" Foreground="Gray"/>
                                                </StackPanel>
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    
                                    <!-- 描述：推送说明 / commit message -->
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="11" 
                                               Foreground="#424242"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="580"
                                               Margin="0,1,0,0"/>
                                    
                                    <!-- 时间 -->
                                    <TextBlock Text="{Binding LastPushTime}" 
                                               FontSize="10" 
                                               Foreground="#757575"
                                               Margin="0,0,0,2"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>

                        <!-- 让 TreeViewItem 更好看 + 支持双向展开 -->
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="2,1"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Border>

                <!-- 底部提示 -->
                <Border Grid.Row="2" Background="#E8F5E9" Padding="8" Margin="0,8,0,0" CornerRadius="3">
                    <TextBlock Text="说明：已加载 26 个分支。鼠标悬停分支名称可查看完整描述。子节点默认展开前两层，可手动点击箭头继续展开。"
                               Foreground="#2E7D32" FontSize="12"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- ==================== 页面3：推送操作 ==================== -->
        <TabItem Header="推送操作">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel>
                    <!-- 1. 提交到本地 -->
                    <GroupBox Header="1. 提交分支到本地仓库（Commit）" Margin="0,0,0,16" Padding="12">
                        <StackPanel>
                            <TextBlock Text="分支名称（对应工作树文件夹名）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="CommitBranchBox" FontSize="15" Height="36" 
                                     Text="2026-xxx-项目名称"/>

                            <TextBlock Text="提交描述（Commit Message）" FontWeight="SemiBold" Margin="0,12,0,4"/>
                            <TextBox x:Name="CommitMessageBox" Height="70" AcceptsReturn="True" 
                                     TextWrapping="Wrap" FontSize="13"
                                     Text="更新内容说明"/>

                            <Button x:Name="CommitLocalButton" Content="提交到本地仓库 (git add . &amp; git commit)" 
                                    Height="42" Margin="0,12,0,0" FontSize="15" FontWeight="Bold"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="CommitLocalButton_Click"/>
                            
                            <TextBlock Text="说明：与「一键操作」批量推送逻辑一致，含文件大小检查（≥50MB 警告、≥100MB LFS 确认）后执行 add + commit" 
                                       TextWrapping="Wrap" Foreground="#666" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. 推送到 GitHub（单个分支） -->
                    <GroupBox Header="2. 推送分支到 GitHub" Margin="0,0,0,16" Padding="12">
                        <StackPanel>
                            <TextBlock Text="分支名称" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="PushBranchBox" FontSize="15" Height="36"/>

                            <Button x:Name="PushToGithubButton" Content="推送到 GitHub (git push origin 分支名)" 
                                    Height="42" Margin="0,12,0,0" FontSize="15" FontWeight="Bold"
                                    Style="{StaticResource SuccessButton}"
                                    Click="PushToGithubButton_Click"/>

                            <TextBlock Text="提示：请先确保已在本地执行过提交（第1步）" 
                                       Foreground="#C62828" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 本页状态 -->
                    <Border Background="#FFF3E0" Padding="10" CornerRadius="4">
                        <TextBlock x:Name="PushPageStatusText" Text="就绪 - 请选择要操作的分支" 
                                   Foreground="#E65100" FontSize="13"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ==================== 页面4：一键操作 ==================== -->
        <TabItem Header="一键操作">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                <StackPanel>
                    <!-- 1. 一键推送全部 worktree 到本地裸仓库 -->
                    <GroupBox Header="1. 一键推送全部工作树到本地裸仓库" Margin="0,0,0,16" Padding="12">
                        <StackPanel>
                            <TextBlock Text="此操作将遍历 C:\OneHistory\OneHistory-Projects 中的全部工作树，对每个项目执行 git add . &amp; git commit，提交到裸仓库。"
                                       TextWrapping="Wrap" Foreground="#555" Margin="0,0,0,8"/>

                            <TextBlock Text="推送前文件大小检查：" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="• 单个文件 ≥ 50 MB → 警告并记录日志，仍继续推送" 
                                       Foreground="#E65100" FontSize="12" Margin="8,0,0,2"/>
                            <TextBlock Text="• 单个文件 ≥ 100 MB → 检查是否已使用 Git LFS 指针" 
                                       Foreground="#C62828" FontSize="12" Margin="8,0,0,2"/>
                            <TextBlock Text="  已使用 LFS → 放行；未使用 LFS → 弹窗询问是否启用指针" 
                                       Foreground="#555" FontSize="12" Margin="16,0,0,2"/>
                            <TextBlock Text="  拒绝启用 LFS → 跳过该项目推送" 
                                       Foreground="#555" FontSize="12" Margin="16,0,0,8"/>

                            <TextBlock Text="批量提交描述（Commit Message）" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox x:Name="BatchCommitMessageBox" Height="36" FontSize="14"
                                     Text="一键推送更新"/>

                            <Button x:Name="PushAllWorktreesButton" Content="一键推送全部工作树到本地裸仓库" 
                                    Height="48" Margin="0,12,0,0" FontSize="16" FontWeight="Bold"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="PushAllWorktreesButton_Click"/>

                            <TextBlock Text="说明：无变更的工作树将自动跳过（nothing to commit）" 
                                       Foreground="#666" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. 一键推送全部分支到 GitHub -->
                    <GroupBox Header="2. 一键推送全部本地分支到 GitHub（危险操作）" Margin="0,0,0,16" Padding="12" BorderBrush="#C62828" BorderThickness="1.5">
                        <StackPanel>
                            <TextBlock Text="此操作将执行：git push --all origin" 
                                       FontWeight="SemiBold" Foreground="#C62828" Margin="0,0,0,8"/>

                            <Button x:Name="PushAllButton" Content="一键推送全部分支到 GitHub" 
                                    Height="48" FontSize="16" FontWeight="Bold"
                                    Style="{StaticResource DangerButton}"
                                    Click="PushAllButton_Click"/>

                            <TextBlock Text="警告：请确保所有需要推送的分支都已在本地的相应工作树中完成提交！" 
                                       Foreground="#666" FontSize="12" Margin="0,8,0,0"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 本页状态 -->
                    <Border Background="#E8EAF6" Padding="10" CornerRadius="4">
                        <TextBlock x:Name="OneClickPageStatusText" Text="就绪 - 选择要执行的一键操作" 
                                   Foreground="#283593" FontSize="13"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>

        <!-- ==================== 全局共享日志（所有页面可见，固定高度） ==================== -->
        <Border Grid.Row="2" BorderBrush="#CCCCCC" BorderThickness="1" Background="#FAFAFA" CornerRadius="4">
            <GroupBox Header="执行日志（全局共享 - 所有页面可见）" Padding="6" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="LogTextBox" 
                             Grid.Row="0"
                             IsReadOnly="True" 
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             FontFamily="Consolas" FontSize="12"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             Background="White"
                             MaxHeight="175"/>
                    <Button Grid.Row="1" Content="清空日志" Width="70" Height="22" 
                            HorizontalAlignment="Right" Margin="0,4,0,0"
                            Click="ClearLogButton_Click"/>
                </Grid>
            </GroupBox>
        </Border>
    </Grid>
</Window>
