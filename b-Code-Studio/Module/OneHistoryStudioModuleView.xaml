<UserControl x:Class="OneHistoryStudio.Module.OneHistoryStudioModuleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="32" MaxWidth="720" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="OneHistoryStudio" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Grid.Row="1" Margin="0,12,0,0"
                   Text="V3 模块已由 AppShell 3.1.7 宿主加载"
                   FontSize="16" />
        <TextBlock Grid.Row="2" Margin="0,8,0,0"
                   Text="当前为初步部署骨架；业务服务组合将在宿主服务模块合同冻结后接入。"
                   TextWrapping="Wrap" Opacity="0.72" />
    </Grid>
</UserControl>
