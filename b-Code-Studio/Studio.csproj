<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="StudioVersion.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OneHistoryStudio</RootNamespace>
    <AssemblyName>OneHistoryStudio</AssemblyName>
    <Product>OneHistoryStudio</Product>
    <Title>OneHistoryStudio</Title>
    <!-- Studio.csproj 位于组件根；嵌套测试由 Smoke.csproj 独立编译。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests\**</DefaultItemExcludes>
    <!-- N-01:每显示器 DPI 感知(Per-Monitor V2) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>OneHistoryStudio.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OneHistory.AppShell.Core" Version="3.0.0" />
    <PackageReference Include="OneHistory.AppShell.Services" Version="3.0.0" />
    <PackageReference Include="OneHistory.AppShell.Shell" Version="3.0.0" />
    <PackageReference Include="OneHistory.AppShell.ServiceHost" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      产品文档位于 020 根级 b-Office；Link 一律保持 docs\，随程序发布的 Help 目录结构
      (b-Publish\current\docs\*.md 候选、z-Package\docs\*.md 正式包) 是面向使用者的产品界面，
      不随源码目录调整而变。
    -->
    <Content Include="..\b-Office\meta\使用说明.md" Link="docs\README.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\b-Office\meta\命令手册.md" Link="docs\命令手册.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\b-Office\meta\MCP接入与安全.md" Link="docs\MCP接入与安全.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\b-Office\meta\项目库与备份.md" Link="docs\项目库与备份.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\b-Office\meta\模块开发手册.md" Link="docs\模块开发手册.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\b-Office\meta\发布与升级.md" Link="docs\发布与升级.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
