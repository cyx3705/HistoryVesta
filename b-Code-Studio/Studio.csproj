<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="StudioVersion.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>OneHistoryStudio</RootNamespace>
    <AssemblyName>OneHistoryStudio</AssemblyName>
    <Product>OneHistoryStudio</Product>
    <Title>OneHistoryStudio</Title>
    <!-- 每显示器 DPI 感知（Per-Monitor V2） -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>OneHistoryStudio.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OneHistory.AppShell.Core" Version="3.0.3" />
    <PackageReference Include="OneHistory.AppShell.Services" Version="3.0.3" />
    <PackageReference Include="OneHistory.AppShell.Shell" Version="3.0.3" />
    <PackageReference Include="OneHistory.AppShell.ServiceHost" Version="3.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- V3 module candidate is a separate assembly; keep its WPF sources out of the legacy EXE glob. -->
    <Compile Remove="Module\**" />
    <EmbeddedResource Remove="Module\**" />
    <None Remove="Module\**" />
    <Page Remove="Module\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy EXE compilation remains a migration regression surface only. -->
    <Content Include="..\b-Office\current\项目概览.md" Link="docs\项目概览.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\b-Office\current\技术合同.md" Link="docs\技术合同.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\b-Office\current\有效决策.md" Link="docs\有效决策.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\b-Office\current\验证合同.md" Link="docs\验证合同.md" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\b-Office\package\模块API.md" Link="docs\模块API.md" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
