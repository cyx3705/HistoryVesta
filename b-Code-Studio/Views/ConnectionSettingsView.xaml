<UserControl x:Class="OneHistoryStudio.Views.ConnectionSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Foreground" Value="#555B63" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="连接与端口" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="ConnectionStateText" Foreground="#555B63" Margin="0,3,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="刷新" Click="OnRefreshClick" ToolTip="刷新本机 profile 和服务器状态" />
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,10">
            <TextBlock Text="当前设备角色" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
            <RadioButton x:Name="ServerRole" Content="服务器端" GroupName="Role" Padding="8,4"
                         Checked="OnRoleChanged" />
            <RadioButton x:Name="ClientRole" Content="客户端" GroupName="Role" Padding="8,4"
                         Margin="8,0,0,0" Checked="OnRoleChanged" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid x:Name="ClientPanel">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="118" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="服务器地址" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="EndpointBox" Grid.Column="1" Margin="0,0,0,8"
                         ToolTip="非回环地址必须使用 https://host:port/" />
                <TextBlock Grid.Row="1" Text="证书指纹" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="FingerprintBox" Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                         ToolTip="服务器页面显示的 SHA-256 指纹，首次连接必须人工核对" />
                <TextBlock Grid.Row="2" Text="设备名称" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="DeviceNameBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8" />
                <TextBlock Grid.Row="3" Text="一次性配对码" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PairCodeBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,12"
                             ToolTip="配对码不会写入日志或 bootstrap.json" />
                <WrapPanel Grid.Row="4" Grid.Column="1">
                    <Button Content="保存并重启" Click="OnSaveClick" />
                    <Button Content="配对" Margin="8,0,0,0" Click="OnPairClick" />
                    <Button Content="重连" Margin="8,0,0,0" Click="OnReconnectClick" />
                    <Button Content="断开并清除" Margin="8,0,0,0" Click="OnForgetClick" />
                </WrapPanel>
                <TextBlock x:Name="ClientIdentityText" Grid.Row="5" Grid.ColumnSpan="2"
                           Margin="0,14,0,0" Foreground="#555B63" TextWrapping="Wrap" />
            </Grid>

            <Grid x:Name="ServerPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="本机服务器" FontWeight="SemiBold" />
                        <TextBlock x:Name="ServerStatusText" Foreground="#555B63" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="保存并重启" Click="OnSaveClick" />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CheckBox x:Name="LanEnabledCheck" Content="允许局域网连接"
                              Grid.ColumnSpan="2" VerticalAlignment="Center" />
                    <TextBlock Grid.Row="1" Text="Private IPv4" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="LanBindBox" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                              IsEditable="True" ToolTip="只允许当前活动网卡的 Private IPv4" />
                    <TextBlock Grid.Row="2" Text="HTTPS 端口" Margin="0,6,0,0"
                               Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LanPortBox" Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" />
                    <WrapPanel Grid.Row="3" Grid.Column="1" Margin="0,8,0,0">
                        <Button Content="应用 LAN 配置" Click="OnApplyLanClick" />
                        <Button Content="轮换证书" Margin="8,0,0,0" Click="OnRotateCertificateClick" />
                        <Button Content="生成配对码" Margin="8,0,0,0" Click="OnGeneratePairCodeClick" />
                    </WrapPanel>
                </Grid>

                <TextBlock x:Name="CertificateStatusText" Grid.Row="2" Margin="0,4,0,4"
                           Foreground="#555B63" TextWrapping="Wrap" />
                <TextBlock x:Name="PairCodeText" Grid.Row="3" Margin="0,8,0,8"
                           FontSize="16" FontWeight="SemiBold" />
                <DataGrid x:Name="DevicesGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="设备" Binding="{Binding Name}" Width="2*" />
                        <DataGridTextColumn Header="Device ID" Binding="{Binding DeviceId}" Width="2*" />
                        <DataGridTextColumn Header="权限" Binding="{Binding Scope}" Width="*" />
                        <DataGridTextColumn Header="最近连接" Binding="{Binding LastUsedAt}" Width="2*" />
                        <DataGridTextColumn Header="撤销时间" Binding="{Binding RevokedAt}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,8,0,0"
                   Foreground="#4B5563" TextWrapping="Wrap" />
    </Grid>
</UserControl>
