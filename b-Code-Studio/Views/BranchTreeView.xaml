<UserControl x:Class="HistoryJanus.Views.BranchTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Shell.Brush.Surface}"
             Foreground="{DynamicResource Shell.Brush.TextPrimary}">
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RescanButton" Content="重新扫描"
                    Padding="12,3" Click="OnRescanClick" />
            <Button x:Name="ExpandAllButton" Content="全部展开" IsEnabled="False"
                    Padding="12,3" Margin="8,0,0,0" Click="OnExpandAllClick" />
            <Button x:Name="CollapseAllButton" Content="全部折叠" IsEnabled="False"
                    Padding="12,3" Margin="8,0,0,0" Click="OnCollapseAllClick" />
            <TextBlock x:Name="TreeStatus" VerticalAlignment="Center" Margin="12,0,0,0"
                       Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                       Text="启动时自动加载缓存;树有变化点「重新扫描」" />
        </StackPanel>
        <TreeView x:Name="BranchTree"
                  Background="{DynamicResource Shell.Brush.Surface}"
                  Foreground="{DynamicResource Shell.Brush.TextPrimary}"
                  BorderBrush="{DynamicResource Shell.Brush.Hairline}" BorderThickness="1"
                  SelectedItemChanged="OnBranchSelected"
                  PreviewMouseRightButtonDown="OnTreePreviewMouseRightButtonDown">
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="查看分支历史" Click="OnViewHistoryClick" />
                    <MenuItem Header="选择回滚节点..." Click="OnChooseRollbackClick" />
                    <Separator />
                    <MenuItem Header="打开项目" Click="OnOpenProjectClick" />
                    <MenuItem Header="复制分支名" Click="OnCopyBranchClick" />
                </ContextMenu>
            </TreeView.ContextMenu>
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,1">
                        <StackPanel.ToolTip>
                            <StackPanel MaxWidth="500">
                                <TextBlock Text="{Binding BranchName}" FontWeight="Bold" />
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LastPushTime}" FontSize="10"
                                           Foreground="{DynamicResource Shell.Brush.TextSecondary}" />
                            </StackPanel>
                        </StackPanel.ToolTip>
                        <TextBlock Text="{Binding BranchName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LastPushTime}"
                                   Foreground="{DynamicResource Shell.Brush.TextSecondary}" FontSize="11"
                                   Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</UserControl>
