<UserControl x:Class="HistoryJanus.Views.MetaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Shell.Brush.Surface}"
             Foreground="{DynamicResource Shell.Brush.TextPrimary}">
    <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新"
                    Padding="12,3" Margin="8,0,0,0" Click="OnRefreshClick" />
            <TextBlock Text="搜索:" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="{DynamicResource Shell.Brush.TextSecondary}" />
            <TextBox x:Name="SearchBox" VerticalContentAlignment="Center"
                     TextChanged="OnSearchChanged" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="ListStatus"
                   Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                   Margin="0,6,0,0" Text="双击一行在资源管理器中打开该元文件夹(proj.metaopen)" />
        <ListView x:Name="MetaList"
                  Background="{DynamicResource Shell.Brush.Surface}"
                  Foreground="{DynamicResource Shell.Brush.TextPrimary}"
                  BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                  MouseDoubleClick="OnRowDoubleClick">
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{DynamicResource Shell.GridHeader}">
                    <GridViewColumn Header="项目" Width="220"
                                    DisplayMemberBinding="{Binding ProjectName}" />
                    <GridViewColumn Header="元文件夹" Width="200"
                                    DisplayMemberBinding="{Binding MetaName}" />
                    <GridViewColumn Header="最后修改" Width="130"
                                    DisplayMemberBinding="{Binding LastWriteTime}" />
                    <GridViewColumn Header="路径" Width="480"
                                    DisplayMemberBinding="{Binding FullPath}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
