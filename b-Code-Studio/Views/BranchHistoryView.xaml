<UserControl x:Class="HistoryJanus.Views.BranchHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource Shell.Brush.Surface}"
             Foreground="{DynamicResource Shell.Brush.TextPrimary}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="BranchTitle" Text="在项目总览或项目操作中选择项目"
                       FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
            <TextBlock x:Name="BoundaryText" Margin="0,3,0,0"
                       Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                       TextWrapping="Wrap" />
            <WrapPanel Margin="0,7,0,0">
                <Button x:Name="RefreshButton" Content="刷新" Padding="10,3"
                        Click="OnRefreshClick" />
                <Button x:Name="RemoteRefreshButton" Content="刷新远端" Padding="10,3"
                        Margin="6,0,0,0" Click="OnRemoteRefreshClick" />
                <Button x:Name="LoadMoreButton" Content="加载更早" Padding="10,3"
                        Margin="6,0,0,0" IsEnabled="False" Click="OnLoadMoreClick" />
            </WrapPanel>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="0,6,0,0"
                   Foreground="{DynamicResource Shell.Brush.TextSecondary}"
                   Text="尚未选择项目" TextWrapping="Wrap" />

        <ListView x:Name="HistoryList"
                  Background="{DynamicResource Shell.Brush.Surface}"
                  Foreground="{DynamicResource Shell.Brush.TextPrimary}"
                  BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                  SelectionMode="Single"
                  MouseDoubleClick="OnRowDoubleClick"
                  PreviewMouseRightButtonDown="OnHistoryPreviewMouseRightButtonDown"
                  ContextMenuOpening="OnContextMenuOpening"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="查看提交详情" Click="OnShowDetailClick" />
                    <MenuItem Header="预览与当前版本差异" Click="OnShowDiffClick" />
                    <MenuItem Header="复制提交 SHA" Click="OnCopyShaClick" />
                    <Separator />
                    <MenuItem Header="生成恢复提交..." Click="OnRollbackClick" />
                    <MenuItem x:Name="HardResetItem" Header="硬重置到此节点..."
                              Click="OnHardResetClick" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView ColumnHeaderContainerStyle="{DynamicResource Shell.GridHeader}">
                    <GridViewColumn Header="节点" Width="58" DisplayMemberBinding="{Binding Marker}" />
                    <GridViewColumn Header="提交说明" Width="360" DisplayMemberBinding="{Binding Subject}" />
                    <GridViewColumn Header="时间" Width="138" DisplayMemberBinding="{Binding TimeDisplay}" />
                    <GridViewColumn Header="作者" Width="100" DisplayMemberBinding="{Binding Author}" />
                    <GridViewColumn Header="origin" Width="76" DisplayMemberBinding="{Binding RemoteDisplay}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
