    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <Product>AppShellPackageSmoke</Product>
    <AssemblyTitle>AppShellPackageSmoke</AssemblyTitle>
    <Title>AppShellPackageSmoke</Title>
