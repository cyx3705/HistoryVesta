<Window x:Class="AppShell.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
        xmlns:adc="clr-namespace:AvalonDock.Controls;assembly=AvalonDock"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!--
            W-04 / §14.2 清单 2:工具窗格标签条移至组顶部。
            经代码赋给 DockingManager.AnchorablePaneControlStyle(主题字典的
            隐式 Style 不会命中窗格控件,浮动窗口也走该属性,可一并覆盖)。
        -->
        <ControlTemplate x:Key="TabsTopAnchorablePaneTemplate"
                         TargetType="{x:Type adc:LayoutAnchorablePaneControl}">
            <Grid ClipToBounds="True"
                  KeyboardNavigation.TabNavigation="Local"
                  SnapsToDevicePixels="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!-- 透明底层用于捕获鼠标事件(拖拽停靠需要) -->
                <Border Grid.RowSpan="2" Background="Transparent" />
                <adc:AnchorablePaneTabPanel x:Name="HeaderPanel"
                                            Grid.Row="0"
                                            Panel.ZIndex="1"
                                            IsItemsHost="True"
                                            FlowDirection="LeftToRight"
                                            KeyboardNavigation.TabIndex="1" />
                <Border x:Name="ContentPanel"
                        Grid.Row="1"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        KeyboardNavigation.DirectionalNavigation="Contained"
                        KeyboardNavigation.TabIndex="2"
                        KeyboardNavigation.TabNavigation="Cycle">
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                      ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                      ContentSource="SelectedContent"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Border>
            </Grid>
        </ControlTemplate>
    </Window.Resources>
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" />

        <StatusBar DockPanel.Dock="Bottom" Height="26">
            <StatusBarItem>
                <TextBlock x:Name="StatusLeft" Text="就绪" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <!-- S-03:错误计数,点击跳转控制台并过滤 Error -->
                    <TextBlock x:Name="StatusErrors"
                               Foreground="#C42525"
                               Visibility="Collapsed"
                               Cursor="Hand"
                               Margin="0,0,16,0"
                               MouseLeftButtonDown="OnStatusErrorsClick" />
                    <TextBlock x:Name="StatusRight" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <ad:DockingManager x:Name="DockManager" Background="#F3F4F6" />
    </DockPanel>
</Window>
