<Window x:Class="AppShell.Shell.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ad="clr-namespace:AvalonDock;assembly=AvalonDock"
        Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        Background="{DynamicResource Shell.Brush.Canvas}">

    <!--
        3.1 外壳(UI-02 / UI-03 / UI-04 / UI-05):
        没有独立标题栏那一层 —— 停靠区从窗体顶端起算,窗口按钮组浮在右上角,
        与最上一排页签同处一行(高度都是 Shell.Size.Tab)。页签之外的空白
        属于 WindowChrome 的标题区,因此仍可拖动、双击最大化和贴边分屏;
        页签本身在 ShellDocking.xaml 里声明为 IsHitTestVisibleInChrome,可正常点击。

        WindowChrome 的装配与降级在 ShellWindow.xaml.cs 的 SourceInitialized 完成
        (消费方可能在构造之后才改 WindowStyle,构造期判定会误判)。
    -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 索引 0 是主题令牌,深色切换时整份替换,见 ApplyTheme -->
                <ResourceDictionary Source="/AppShell.Shell;component/Themes/ShellTokens.xaml" />
                <ResourceDictionary Source="/AppShell.Shell;component/Themes/ShellControls.xaml" />
                <ResourceDictionary Source="/AppShell.Shell;component/Themes/ShellChrome.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 图标一律用几何图形,不依赖 Segoe MDL2 Assets(精简镜像可能缺字体) -->
            <Geometry x:Key="Shell.Icon.Menu">M 0,0 H 14 M 0,5 H 14 M 0,10 H 14</Geometry>
            <Geometry x:Key="Shell.Icon.Minimize">M 0,0 H 10</Geometry>
            <Geometry x:Key="Shell.Icon.Maximize">M 0,0 H 10 V 10 H 0 Z</Geometry>
            <Geometry x:Key="Shell.Icon.Restore">M 0,2.5 H 7.5 V 10 H 0 Z M 2.5,2.5 V 0 H 10 V 7.5 H 7.5</Geometry>
            <Geometry x:Key="Shell.Icon.Close">M 0,0 L 10,10 M 10,0 L 0,10</Geometry>
            <Geometry x:Key="Shell.Icon.ExitFocus">M 0,4 H 4 V 0 M 12,0 V 4 H 16 M 16,8 H 12 V 12 M 4,12 V 8 H 0</Geometry>
            <RoutedCommand x:Key="Shell.Command.PageAction" />
        </ResourceDictionary>
    </Window.Resources>

    <!-- RootBorder:窗体最大化时由代码补偿 WindowChrome 溢出(UI-02.5) -->
    <Border x:Name="RootBorder" Background="{DynamicResource Shell.Brush.Canvas}">
        <Grid x:Name="RootGrid">
            <ad:DockingManager x:Name="DockManager"
                               Background="{DynamicResource Shell.Brush.Canvas}" />

            <!--
                UI-02.3:菜单 + 最小化 + 最大化还原 + 关闭,次序固定、任何形态都不删减。
                正常状态下会挂到中央文档窗格的页签行；没有中央文档宿主时才回退到
                本层右上角。这样工具窗格的动作栏不会再与窗口控制栏共用一个位置。
            -->
            <StackPanel x:Name="ChromeBar"
                        Height="{DynamicResource Shell.Size.Tab}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Orientation="Horizontal">
                <!-- UI-05.3:错误计数(原状态栏) -->
                <Button x:Name="ErrorBadge"
                        Style="{StaticResource Shell.ErrorBadge}"
                        Visibility="Collapsed"
                        Click="OnErrorBadgeClick" />

                <!-- UI-04.4:退出专注,仅页面最大化时出现 -->
                <Button x:Name="ExitFocusButton"
                        Style="{StaticResource Shell.ChromeIconButton}"
                        Visibility="Collapsed"
                        Click="OnExitFocusClick">
                    <Path Data="{StaticResource Shell.Icon.ExitFocus}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>

                <!-- UI-03:折叠后的菜单,恒在三个窗口按钮左侧 -->
                <Button x:Name="MenuButton"
                        Style="{StaticResource Shell.ChromeIconButton}"
                        Click="OnMenuButtonClick">
                    <Path Data="{StaticResource Shell.Icon.Menu}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.3" />
                </Button>

                <Button x:Name="MinimizeButton"
                        Style="{StaticResource Shell.WindowButton}"
                        ToolTip="最小化"
                        Click="OnMinimizeClick">
                    <Path Data="{StaticResource Shell.Icon.Minimize}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>

                <Button x:Name="MaximizeButton"
                        Style="{StaticResource Shell.WindowButton}"
                        ToolTip="最大化"
                        Click="OnMaximizeRestoreClick">
                    <Path x:Name="MaximizeIcon"
                          Data="{StaticResource Shell.Icon.Maximize}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>

                <Button x:Name="CloseButton"
                        Style="{StaticResource Shell.WindowButton.Close}"
                        ToolTip="关闭"
                        Click="OnCloseClick">
                    <Path Data="{StaticResource Shell.Icon.Close}"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" />
                </Button>
            </StackPanel>

            <!-- UI-05.2:指令结果瞬时回执(原状态栏左侧信息) -->
            <Border x:Name="Toast"
                    Style="{StaticResource Shell.Toast}"
                    MouseLeftButtonDown="OnToastClick">
                <TextBlock x:Name="ToastText" Style="{StaticResource Shell.Toast.Text}" />
            </Border>
        </Grid>
    </Border>
</Window>
