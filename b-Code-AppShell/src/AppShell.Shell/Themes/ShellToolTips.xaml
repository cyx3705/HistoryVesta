<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Shell.Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Shell.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Shell.Font.Small}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Margin="0,0,10,10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Shell.Brush.Hairline}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Shell.Radius.Inner}"
                            Effect="{DynamicResource Shell.Shadow.Flyout}"
                            Padding="9,5">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
