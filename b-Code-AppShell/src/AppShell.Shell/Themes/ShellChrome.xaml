<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        UI-02 / UI-03 / UI-05:顶栏、窗口控件、菜单按钮、错误徽章与瞬时提示。
        图标一律用 Path 绘制,不依赖 Segoe MDL2 Assets 等字体 —— 目标平台是
        Win10 IoT LTSC 2021,精简镜像可能缺字体。
    -->

    <!-- ================================================================ 窗口控件(UI-02.3) -->

    <!--
        菜单 + 最小化 + 最大化还原 + 关闭 共用底座。
        WindowChrome.IsHitTestVisibleInChrome=True 保留为兼容性保护；3.1 的主窗体
        已将 CaptionHeight 归零，只在中央文档页签空白处处理拖动。
    -->
    <Style x:Key="Shell.WindowButton" TargetType="Button">
        <Setter Property="Width" Value="{DynamicResource Shell.Size.WindowButton}" />
        <Setter Property="Height" Value="{DynamicResource Shell.Size.Tab}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Shell.Brush.WindowButtonHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Shell.Brush.WindowButtonPressed}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Shell.Brush.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮:悬停整块变红、图标转白,与 Windows 惯例一致(UI-02.4) -->
    <Style x:Key="Shell.WindowButton.Close" TargetType="Button"
           BasedOn="{StaticResource Shell.WindowButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Shell.Brush.CloseHover}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Shell.Brush.TextOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Shell.Brush.CloseHoverPressed}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Shell.Brush.TextOnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 顶栏图标(菜单、退出专注):与窗口控件同底座,宽度略窄 -->
    <Style x:Key="Shell.ChromeIconButton" TargetType="Button"
           BasedOn="{StaticResource Shell.WindowButton}">
        <Setter Property="Width" Value="36" />
    </Style>


    <!-- ================================================================ 错误徽章(UI-05.3) -->

    <Style x:Key="Shell.ErrorBadge" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Shell.Brush.DangerSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.Danger}" />
        <Setter Property="FontFamily" Value="{DynamicResource Shell.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Shell.Font.Small}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Shell.Radius.Inner}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background"
                                    Value="{DynamicResource Shell.Brush.Danger}" />
                            <Setter Property="Foreground"
                                    Value="{DynamicResource Shell.Brush.TextOnAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ 瞬时提示(UI-05.2) -->

    <Style x:Key="Shell.Toast" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Shell.Brush.Surface}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Shell.Radius.Inner}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Shell.Brush.Hairline}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,16,16" />
        <Setter Property="MaxWidth" Value="520" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Effect" Value="{DynamicResource Shell.Shadow.Flyout}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <Style x:Key="Shell.Toast.Text" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Shell.Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Shell.Font.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Shell.Brush.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxHeight" Value="60" />
    </Style>

</ResourceDictionary>
