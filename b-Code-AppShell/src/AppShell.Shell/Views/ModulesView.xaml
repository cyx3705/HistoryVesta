<UserControl x:Class="AppShell.Shell.Views.ModulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <UserControl.Resources>
        <!-- 视图是独立 BAML:StaticResource 必须在自己的作用域里找得到 -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AppShell.Shell;component/Themes/ShellControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="RefreshButton" Content="刷新模块" Click="OnReloadClick" />
            <Button Content="打开模块目录" Margin="8,0,0,0" Click="OnOpenDirClick" />
            <Separator x:Name="ToolRegistrySeparator" Margin="10,0" Visibility="Collapsed" />
            <!-- 派生应用注册对应 tool.* 能力后才显示这些可选入口。 -->
            <Button x:Name="ToolScanButton" Content="扫描项目库工具"
                    Visibility="Collapsed" Click="OnToolScanClick"
                    ToolTip="tool.scan:发现项目库中声明了 module.manifest.json 的工具" />
            <Button x:Name="ToolSyncButton" Content="同步全部工具" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="OnToolSyncClick"
                    ToolTip="tool.sync all=true:把未同步/已过期的工具入库" />
            <Button x:Name="ToolRemoveButton" Content="移除所选工具" Margin="8,0,0,0"
                    Visibility="Collapsed" IsEnabled="False" Click="OnToolRemoveClick"
                    ToolTip="tool.remove:删除所选模块的槽与溯源(需二次确认)" />
            <TextBlock x:Name="DirText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource Shell.Brush.TextSecondary}" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="{DynamicResource Shell.Brush.TextSecondary}" Margin="0,6,0,0"
                   Text="模块 DLL(+可选 XML 注释与 &lt;模块名&gt;.panel.json 面板)放入目录即自动装载" />

        <Grid>
            <ListView x:Name="ModuleList" SelectionChanged="OnModuleSelectionChanged">
                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{StaticResource Shell.GridHeader}">
                        <GridViewColumn Header="模块" Width="160"
                                        DisplayMemberBinding="{Binding ModuleName}" />
                        <GridViewColumn Header="版本" Width="80"
                                        DisplayMemberBinding="{Binding Version}" />
                        <GridViewColumn Header="暴露" Width="80"
                                        DisplayMemberBinding="{Binding Mode}" />
                        <GridViewColumn Header="指令数" Width="60"
                                        DisplayMemberBinding="{Binding CommandCount}" />
                        <GridViewColumn Header="来源文件" Width="180"
                                        DisplayMemberBinding="{Binding AssemblyFile}" />
                        <GridViewColumn Header="描述" Width="320"
                                        DisplayMemberBinding="{Binding Description}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</UserControl>
