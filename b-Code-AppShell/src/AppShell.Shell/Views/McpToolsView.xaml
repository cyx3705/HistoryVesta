<UserControl x:Class="AppShell.Shell.Views.McpToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <DockPanel Margin="8">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="135" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="搜索:" VerticalAlignment="Center" Margin="0,0,6,0" />
            <TextBox Grid.Column="1" x:Name="SearchBox" TextChanged="OnFilterChanged"
                     VerticalContentAlignment="Center" MinWidth="120" />
            <TextBlock Grid.Column="2" Text="域:" VerticalAlignment="Center" Margin="10,0,6,0" />
            <ComboBox Grid.Column="3" x:Name="DomainFilterBox" SelectionChanged="OnFilterChanged"
                      VerticalContentAlignment="Center" />
            <TextBlock Grid.Column="4" Text="MCP:" VerticalAlignment="Center" Margin="10,0,6,0" />
            <ComboBox Grid.Column="5" x:Name="McpFilterBox" SelectionChanged="OnFilterChanged" SelectedIndex="0">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="当前可见" />
                <ComboBoxItem Content="当前隐藏" />
                <ComboBoxItem Content="硬排除" />
                <ComboBoxItem Content="危险拒绝" />
            </ComboBox>
            <TextBlock Grid.Column="6" Text="来源:" VerticalAlignment="Center" Margin="10,0,6,0" />
            <ComboBox Grid.Column="7" x:Name="SourceFilterBox" SelectionChanged="OnFilterChanged" SelectedIndex="0">
                <ComboBoxItem Content="全部" />
                <ComboBoxItem Content="framework" />
                <ComboBoxItem Content="app" />
                <ComboBoxItem Content="module" />
            </ComboBox>
            <Button Grid.Column="8" Content="服务状态" Padding="10,3" Margin="10,0,0,0" Click="OnStatusClick" />
            <Button Grid.Column="9" x:Name="RefreshButton" Content="刷新" Padding="10,3" Margin="8,0,0,0"
                    Click="OnRefreshClick" />
        </Grid>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="CustomizedOnlyCheck" Content="有自定义提示词" Checked="OnFilterChanged"
                      Unchecked="OnFilterChanged" />
            <CheckBox x:Name="PendingOnlyCheck" Content="有待审核提案" Margin="14,0,0,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
            <CheckBox x:Name="IncidentOnlyCheck" Content="有事故记录" Margin="14,0,0,0"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Foreground="#555" Margin="0,6,0,0"
                   Text="命令注册表是能力真值；MCP 只是策略投影" TextWrapping="Wrap" />

        <ListView x:Name="ToolList" SelectionChanged="OnToolSelected">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="指令" Width="185" DisplayMemberBinding="{Binding CommandName}" />
                    <GridViewColumn Header="域" Width="70" DisplayMemberBinding="{Binding Domain}" />
                    <GridViewColumn Header="来源" Width="85" DisplayMemberBinding="{Binding Source}" />
                    <GridViewColumn Header="MCP" Width="85" DisplayMemberBinding="{Binding McpState}" />
                    <GridViewColumn Header="参数" Width="48" DisplayMemberBinding="{Binding ParameterCount}" />
                    <GridViewColumn Header="说明" Width="340" DisplayMemberBinding="{Binding Summary}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</UserControl>
