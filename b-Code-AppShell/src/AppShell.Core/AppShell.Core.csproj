<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AppShell.Core</RootNamespace>
    <PackageId>OneHistory.AppShell.Core</PackageId>
    <Title>OneHistory AppShell Core</Title>
    <Description>Core contracts, command infrastructure, and MCP metadata for OneHistory AppShell.</Description>
    <PackageTags>onehistory;appshell;commands;mcp</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
  </ItemGroup>

</Project>
