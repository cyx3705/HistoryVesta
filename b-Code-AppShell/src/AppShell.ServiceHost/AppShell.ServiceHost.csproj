<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>AppShell.ServiceHost</RootNamespace>
    <PackageId>OneHistory.AppShell.ServiceHost</PackageId>
    <Title>OneHistory AppShell Service Host</Title>
    <Description>Headless WPF service host, lifecycle commands, and desktop confirmation for OneHistory AppShell.</Description>
    <PackageTags>onehistory;appshell;service;wpf</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AppShell.Core\AppShell.Core.csproj" />
    <ProjectReference Include="..\AppShell.Services\AppShell.Services.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="All" />
  </ItemGroup>
</Project>
