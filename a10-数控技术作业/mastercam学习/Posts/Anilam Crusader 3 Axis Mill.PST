[POST_VERSION] #DO NOT MOVE OR ALTER THIS LINE# V22.00 P0 E1 W22.00 T1550094737 M22.00 I0 O0
scncpost_revision     := "22.80" # Internal revision number for use by CNC Software only.  Please do not change this number.
scustpost_revision    := "0"  # Revision number for use by Resellers or customers.
# Post Name           : Anilam Crusader 3 Axis Mill
# Product             : MILL
# Machine Name        : ANILAM
# Control Name        : CRUSADER
# Description         : ANILAM CRUSADER
# 4-axis/Axis subs.   : NO
# 5-axis              : NO
# Subprograms         : NO
# Executable          : mp.dll
#
# WARNING: THIS POST IS GENERIC AND IS INTENDED FOR MODIFICATION TO
# THE MACHINE TOOL REQUIREMENTS AND PERSONAL PREFERENCE.
#
# Associated File List$
#
# ANILAM CRUSADER 3 AXIS MILL.mcam-control
# ANILAM CRUSADER 3 AXIS MILL.mcam-mmd
#
#
# Associated File List$
#
# ---------------
#| REVISION LOG: |
# ------------------------------------------------------------------------
# Programmers Note:
# CNC 01/09/02  -  Initial post update for V9.0
# CNC 02/04/03  -  Initial post update for V9.1
# CNC 05/28/03  -  Initial post update for V9.1SP1
# CNC              Updated to X6
# CNC 06/05/18  -  (21.80) Initial post update for Mastercam 2019
# CNC 02/14/19  -  (22.80) Initial post update for Mastercam 2020
#
# ---------------
#| FEATURES:     |
# ------------------------------------------------------------------------
# Users Note:
#
# Following Misc_Reals & Misc_Integers are used:
#
# mr1 -  Feedrate output when ratio is exceeded
# mr2 -  Ratio which we check x/yangle and y/xangle to see if we need a second
#        feedrate
#
# mi1 -  work coordinate system (0=G53, 1=G54, etc)
# mi3 -  Gear Range Select (0=auto,1=low,2=med,3=high)
#
# Options / Usage
#
# mr1/mr2 - mr1 is an extra feedrate that is used only in rotary substitution.
#           If the current ratio of x/yangle or y/xangle is greater than that
#           entered in mr2 the post will output the feedrate contained in mr1.
#           If it is less than the ratio entered the post outputs the feedrate
#           entered at the standard feedrate prompt.
#
# mi3 - Gear Range Select (0=Auto, 1=low, 2=med, 3=high)
#     - If used set formula as follows: use_gear : yes (else, no)
#     - Set formula set_g1 : 1000 (max low_sp) & set_g2 : 2000 (max med_sp)
#     - Set sgear string accordingly
#
# --------------------------------------------------------------------------
#
# ROTARY INFO
# Toolplane demo post - 1014 line in -.nci calls PROT
# Tool axis vector is now available as vtoolx, vtooly, vtoolz
# Rotation angles A,B and C are found from this vector
# Rotary Positioning Support for vertical/horizontal axis rotary table
# (B axis).
# Axis Substitution is activated, although a custom post may be required.
# 4th/5th Axis Support of Head as illustrated below. Although, provisions must
#  be made for actual XYZAB machine location for practical use. As application
#  deems necessary.
#
# --------------------------------------------------------------------------
#Canned text:
#    Entering cantext on a contour point from within Mastercam allows the
#    following functions to enable/disable.
#    Cantext value:
#    1 = Stop =  output the "M00" stop code
#    2 = Ostop = output the "M01" optional stop code
#
# END_HEADER$
#
# --------------------------------------------------------------------------
# Format Statements - i=incr, n=nonmodal, l=leave ldg, t=leave trlg, d=delta
# --------------------------------------------------------------------------
fs  1  1.4l
fs  2  1.4l
fs  3  4 0
fs  4  2 0ln
fs  5  0.1t
fs  6  2 0ln
fs  7  4 0ln
fs  8  0.4li
fs  9  0.4ln
fs  10 1 0
fs  11 1.3l

# --------------------------------------------------------------------------
# Format Assignments
# --------------------------------------------------------------------------
# Axis output formats - Linear
# --------------------------------------------------------------------------
fmt  "X" 1 x$       # X Axis Position
fmt  "Y" 1 y$       # Y Axis Position
fmt  "Z" 1 z$       # Z Axis Position
fmt  "X" 1 xr$      # X Rapid Position
fmt  "Y" 1 yr$      # Y Rapid Position
fmt  "Z" 1 zr$      # Z Rapid Position
fmt  "X" 1 xh$      # X Home Position
fmt  "Y" 1 yh$      # Y Home Position
fmt  "Z" 1 zh$      # Z Home Position
# --------------------------------------------------------------------------
# Axis output formats - Circular
# --------------------------------------------------------------------------
fmt  "I" 1 i$       # Arc center description in X
fmt  "J" 1 j$       # Arc center description in Y
fmt  "K" 1 k$       # Arc center description in Z
fmt    1 xc$        # Arc Center X
fmt    1 yc$        # Arc Center Y
fmt  "R" 9 arcrad$  # Arc Radius
fmt    1 sa$        # Start angle for arc
fmt    1 so$        # Start octant for arc
fmt    1 ea$        # End angle for arc
fmt    1 eo$        # End octant for arc
fmt    1 sweep$     # Angle between start and end of arc
# --------------------------------------------------------------------------
# Axis output formats - Rotary / Tilt
# --------------------------------------------------------------------------
fmt  "A" 1 a$       # A-axis rotation in degrees
fmt  "B" 1 b$       # B-axis rotation in degrees
fmt  "B" 1 c$       # C-axis rotation in degrees
fmt    1 axis$      # Axis of rotation 0=none, 1=X, 2=Y, 3=Z
fmt  "U" 11 xangle # Linear to rotary calc X
fmt  "U" 11 yangle # Linear to rotary calc Y
fmt    1 frot      # Vector calc
fmt    1 rotaxis$   # Rotary Axis Substitution 0=None/1=X/2=Y
fmt    1 rotdia$    # Rotary Axis Substitution Diameter
# --------------------------------------------------------------------------
# Program & Sequence number format
# --------------------------------------------------------------------------
fmt  "O" 7 progno$  # Program Number
fmt  "N" 7 seqno$   # Starting Sequence Number
fmt  "N" 7 seqinc$  # Sequence Number Increment
fmt  "N" 7 n$       # Main Program Sequence Numbers
# --------------------------------------------------------------------------
# Tool format
# --------------------------------------------------------------------------
fmt  "T" 4 t$       # Tool Number
fmt  "T" 4 first_tool$# First Tool Used (bldnxtool: yes)
fmt  "T" 4 next_tool$# Next Tool Used  (bldnxtool: yes)
fmt    9 tldia$     # Tool Diameter
fmt    9 tlrad$     # Tool Radius
fmt    9 trflat$    # Tool Flat Radius
fmt    9 tcr$       # Tool Corner Radius
fmt  "D" 4 tloffno$ # Diameter Offset Number
fmt  "H" 4 tlngno$  # Length Offset Number
# --------------------------------------------------------------------------
# Spindle Speeds & Feedrate output formats
# --------------------------------------------------------------------------
fmt  "S" 3 ss$       # Spindle Speed
fmt  "F" 5 fr$       # Feedrate
fmt    4 dirchg$     # Feerate Accel/Decel Flag
# --------------------------------------------------------------------------
# Cutter Comp formats
# --------------------------------------------------------------------------
fmt    3 ccomp$      # Modal format for ccomp
fmt  "M" 3 cc$       # Cutter Comp.
# --------------------------------------------------------------------------
# Miscellaneous output formats
# --------------------------------------------------------------------------
fmt    5 plane$      # Modal plane code selector
fmt    7 wcs        # make Work Coord. string 'sgwcs' non-modal
fmt  "M" 4 sscode   # Spindle Speed Code  (M59 - M77 from tbl 1)
fmt    10 gcode$     # Format linear G-code selector for modality only
fmt  "C" 4 coolant$  # Coolant
fmt    4 gear       # Gear selector variable
fmt  "M" 4 cantext$  #

# --------------------------------------------------------------------------
# Drill variable formats
# --------------------------------------------------------------------------
fmt       1 drillcyc$   # drillcyc = 0..7
fmt       1 drillcur$   # Drill with current cycle flag (=1 if true)
fmt  "G"  4 drillref   # Initial / Reference Toggle (G98/G99)
fmt  "V22R" 2 dwell$    # Dwell
fmt  "V24R" 2 initht$   # Initial Height
fmt  "V21R" 2 refht$    # Reference Height
fmt  "Z"  1 depth$      # Depth
fmt  "Q"  2 peck1$      # First peck increment (positive)
fmt  "V23R" 2 peck2$    # Second or last peck (positive)
fmt       2 peckclr$    # Safety distance
fmt       1 retr$       # Retract height
fmt  "V20R" 5 frplunge$ # Plunge feedrate in drill cycles

# --------------------------------------------------------------------------
# Formulas - Use ':' instead of '=' to initialize variables
# --------------------------------------------------------------------------
rotary    : no$     # Use rotary axis
use_gear  : yes$    # Set this to 'yes' to output the gear range code(s)
set_g1    : 1000   # Set gear1 (low) max speed
set_g2    : 2000   # Set gear2 (med) max speed (If ss>set_g2=hi)
bldnxtool$ : yes$    # Build next tool table
skipmotest$: no$     # Skip motion test in linear
tooltable$ : 2      # Output tool table  0=no, 1=before header, 2=after header
getnextop$ : yes$    # Build a table of next operations?
plane$     : 0      # Initialize plane code to suppress first G17
spaces$    : 0      # Number of spaces to add between fields
nobrk$     : yes$    # omit breakup of x/y & z rapid moves
seqmax$    : 9999   # Max. sequence number
omitseq$   : no$     # Omit sequence numbers?
frrapid   : 300    # Rapid feedrate? 300.0
frmax     : 300    # Maximum feedrate? 300.0
savefr    : 0      # Save the current feedrate
ssmax     : 3000   # Maximum spindle speed? 3000
breakarcs$ : 0      # Break arcs, 0 = no, 1 = quadrants, 2 = 180deg. max arcs
arctype$   : 1      # Arc center 1=abs, 2=St-Ctr, 3=Ctr-St, 4=unsigned inc.
do_full_arc$ : 0    # Allow full circle output? 0=no, 1=yes
helix_arc$   : 0    # Support helix arc output, 0=no, 1=all planes, 2=XY plane only
arccheck$  : 1      # Check for small arcs, convert to linear
ltol$      : 0.002  # Length tolerance for arccheck
ratio     : 0      # Ratio input to check rotary moves for second feedrate
ratio2    : 0
fr3       : 0      # Third feed input from mr1
rapid     : 0
prv_progno$ : 9999  # Initialize prv_progno

# Global Formulas
wcs       = mi1$    # Work coord. system
sscode    = frange(1,ss$)  # Spindle speed code

# --------------------------------------------------------------------------
#  USE CANNED CYCLES?
# --------------------------------------------------------------------------
usecandrill$ : yes$   # Use canned cycle for Drill
usecanpeck$  : yes$   # Use canned cycle for Peck
usecanchip$  : yes$   # Use canned cycle for Chip Break
usecantap$   : yes$  # Use canned cycle for Tap
usecanbore1$ : yes$  # Use canned cycle for Bore1
usecanbore2$ : yes$  # Use canned cycle for Bore2
usecanmisc1$ : yes$  # Use canned cycle for Misc1
usecanmisc2$ : yes$  # Use canned cycle for Misc2
usemr1       : no$   # Use mr1 for tool diameter instead of param page input

# --------------------------------------------------------------------------
# DEBUG - Switches for debugging purposes
# --------------------------------------------------------------------------
fastmode$ : yes$   # Enable Quick Post Processing, (set to no for debug)
bug1$ : 1         # 0=No display, 1=Generic list box, 2=Editor
bug2$ : 0         # Add postline label to each line at column 'bug2'
bug4$ : 0         # Add -.nci line number to each line? yes/no
whatno$ : yes$     # Ignore whatline branches to plin1 etc.?
linktolvar$  : 1     #Associate X tolerance variables to V9- variable?
linkplnvar$  : 1     #Associate X plane specific variables to V9- variable?
newglobal$  : 0  #Enable error checking for global variables?

skp_lead_flgs$ : 1# Do NOT use v9 style contour flags
get_1004$   : 1   # Find gcode 1004 with getnextop?
rpd_typ_v7$ : 1   # Use Version 7 style contour flags?
strtool_v7$ : 2   # Use Version 7 toolname?
cant_tlchng$ : 1  # Ignore cantext entry on move with tlchng_aft

# --------------------------------------------------------------------------
# Lookup table definitions - for Math Functions FLOOK and FRANGE
# --------------------------------------------------------------------------
flktbl    1     12     # Lookup table no.     No. of entry pairs
         58     63     # Code 1 (output)      Match 1
         59     90     # Code 2               Match 2
         63    112     #   .                    .
         64    180     #   .                    .
         65    224     #   .                    .
         66    355
         67    450
         73    710
         74    900
         75   1400
         76   1800
         77   2800

# --------------------------------------------------------------------------
# Strings - String labels must start with 's' - they are not pre-assigned
# --------------------------------------------------------------------------
#Select operation note
sop00   : "NULL"              # String definition
sop01   : "CONTOUR"           #    "       "
sop02   : "CONTOUR"           #    "       "
sop03   : "DRILL/MISC"        #    "       "
sop04   : "POCKET...."        #    "       "
sop05   : "RULED....."        #    "       "
sop06   : "2D-SWEPT.."        #    "       "
sop07   : "3D-SWEPT.."        #    "       "
sop08   : "REVOLVED.."        #    "       "
sop09   : "LOFT......"        #    "       "
sop10   : "COONS....."        #    "       "
sop11   : "FILLET...."        #    "       "
sop12   : "FLOWLINE.."        #    "       "
sop13   : "M.FINISH.."        #    "       "
sop14   : "M.ROUGH..."        #    "       "
sop15   : "POINT....."        #    "       "
sop16   : "DRILL5AX.."        #    "       "
sop17   : "CURVE5AX.."        #    "       "
sop18   : "OP18......"        #    "       "
sop19   : "OP19......"        #    "       "
sop20   : "OP20......"        #    "       "

sopnote : ""                  # Target string

fstrsel  sop00 opcode$ sopnote 21 -1

# --------------------------------------------------------------------------
# Select motion G code string

sG0     : "G0"  # Linear movement at rapid feedrate G code
sg01    : "G1"  # Linear movement at feedrate G code
sg02    : "G2"  # Circular interpolation CW G code
sg03    : "G3"  # Circular interpolation CCW G code
sgcode : ""      # Target string for linear/circular motion G code

fstrsel  sG0 gcode$ sgcode 4 -1

# --------------------------------------------------------------------------
# Coolant code select string

sm09    : "M9"  # Coolant off
sm08    : "M8"  # Coolant on - Flood
sm07    : "M8"  # Coolant on - Mist
sm06    : "M8"  # Coolant on -Tool
smcool : ""      # Coolant code target string

fstrsel  sm09 coolant$ smcool 4 -1# Boolean handles modality

# --------------------------------------------------------------------------
# Spindle code string select

sm04         : "M4"  # Spindle reverse - no coolant
sm05         : "M5"  # Spindle off     - no coolant
sm03         : "M3"  # Spindle forward - no coolant
sm04f        : "M4"  # Spindle reverse - with coolant - Flood
sm05f        : "M5"  # Spindle off     - with coolant     ''
sm03f        : "M3"  # Spindle forward - with coolant     ''
sm04m        : "M4"  # Spindle reverse - with coolant - Mist
sm05m        : "M5"  # Spindle off     - with coolant     ''
sm03m        : "M3"  # Spindle forward - with coolant     ''
sm04t        : "M4"  # Spindle reverse - with coolant - Tool
sm05t        : "M5"  # Spindle off     - with coolant     ''
sm03t        : "M3"  # Spindle forward - with coolant     ''
spdlon : ""           # Target Spindle-on M-string

spdlsel   = coolant$ * 3 + fsg3(ss$)      # Spindle on selector based on
#   coolant - 0 = off, 1 = flood, 2 = Mist, 3 = Tool
fstrsel  sm04 spdlsel spdlon 12 -1

# --------------------------------------------------------------------------
# Cutter compensation string select

scc0 : ""                # cutter compensation state not changed
sg40    : "G40"          # cancel cutter compensation
sg41    : "G41"          # cutter compensation left
sg42    : "G42"          # cutter compensation right
sg140 : ""               # last linear move --> cancel cutter comp
                    # Note: Reversal of sg40 = "" & sg140 = "G40" cancels comp
                    #       with last linear move
sccomp : ""              # Select cutter compensation

fstrsel  scc0 ccomp$ sccomp 5 -1

# --------------------------------------------------------------------------
# Select work plane G code

sg17        : "G17"    # XY plane code
sg19        : "G19"    # XZ plane code
sg18        : "G18"    # YZ plane code
sgplane : ""           # Workplane G code

fstrsel  sg17 plane$ sgplane 3 -1

# --------------------------------------------------------------------------
# Canned drill cycle G string select

sg81     : "G81"     #  drill      - no dwell
sg82     : "G82"     #  drill      - with dwell
sg83     : "G83"     #  peck drill - no dwell
sg83d    : "G83"     #  peck drill - with dwell
sg73     : "G87"     #  chip break - no dwell
sg73d    : "G87"     #  chip break - with dwell
sg84     : "G85"     #  tap
sg84d    : "G85"     #  tap     # must be here for selector to work
sg85     : "G84"     #  bore #1    - no dwell
sg89     : "G89"     #  bore #1    - with dwell
sg86     : "G86"     #  bore #2    - no dwell
sg86d    : "G86"     #  bore #2    - with dwell
sgm1     : "G81"     #  misc #1    - no dwell
sgm1d    : "G82"     #  misc #1    - with dwell
sgm2     : "G81"     #  misc #2    - no dwell
sgm2d    : "G82"     #  misc #2    - with dwell
sgdrill : ""           #  Target drill cycle G code

drlgsel  = drillcyc$*2 + fsg2(dwell$)  # 16 possible combinations:
                                     #   drillcyc = 0..7
                                     #   dwell    = 0 or non-zero (2 states)
fstrsel  sg81 drlgsel sgdrill 16 -1

# --------------------------------------------------------------------------
# Work coordinate system G code string select

sg53        : "G53"    # Work coordinate system G code #0
sg54        : "G54"    # Work coordinate system G code #1
sg55        : "G55"    # Work coordinate system G code #2
sg56        : "G56"    # Work coordinate system G code #3
sg57        : "G57"    # Work coordinate system G code #4
sg58        : "G58"    # Work coordinate system G code #5
sg59        : "G59"    # Work coordinate system G code #6

sgwcs : ""

fstrsel  sg53 wcs sgwcs 7 -1

# --------------------------------------------------------------------------
# Accel. / decel. code string select

sgaccel     : "G8"     # Axis acceleration code
sgdecel     : "G9"     # Axis deceleration code
sgacc : ""

fstrsel  sgaccel dirchg$ sgacc 2 -1# Select accel/decel code with dir. chg. flag

# --------------------------------------------------------------------------

# Gear Range code string select

sgear0 : ""                  # Auto gear range
sgear1      : "M41"          # Low gear range
sgear2      : "M42"          # Med gear range
sgear3      : "M43"          # High gear range - selected in parameters by mi3
sgear : ""

fstrsel sgear0 gear sgear 4 -1

# --------------------------------------------------------------------------
#Cantext string definitions (spaces must be padded here)

sm00        : "M00"
sm01        : "M01"
strtextno : ""
strcantext : ""
strm          : "M"
sblank : ""

# --------------------------------------------------------------------------
# User-defined Postline labels starting with 'p'
# --------------------------------------------------------------------------
pijk       # Force Plane Change "I, J, K" Values
           if plane$ = 0, *i$, *j$,  k$
           if plane$ = 1,  i$, *j$, *k$
           if plane$ = 2, *i$,  j$, *k$

pinit      # Initialize Vars
           prv_fr$ = 999.999
           prv_frplunge$ = 999.999

pcomment$   # Manual Entry - COMMENTS (on a block by itself) 1005,1006,1007
            if gcode$ = 1005, n$, scomm$,e$  #comment with line numbers
            if gcode$ = 1006, scomm$,e$     #comment w/o line numbers
            if gcode$ = 1007, scomm$,e$     #comment with current move

prot0$      # Rotary Default

prot$       # Rotary Default
           a$ = atan2 (vtoolz$, vtooly$)
           b$ = asin (vtoolx$)

protary    # Rotary Move
           if rotary = 1, n$, *c$, e$    # Ex:Rotary Appl

pr         # Rotary
           frot = abs(vtoolx$)+abs(vtooly$)+abs(vtoolz$)
           vtoolx$ = 0
           vtooly$ = 0
           vtoolz$ = 0

pccdia2    # Cutter Compensation2
           if ccomp$ <> 4, tloffno$

pccdia     # Cutter Compensation
           if ccomp$ <> 0, pccdia2

ptllncomp  # Tool length compensation
           "G43", *tlngno$

pgear_calc # Auto Gear Range Calculation
           if ss$ < set_g2, gear = 2
           if ss$ < set_g1, gear = 1
           if ss$ > set_g2, gear = 3

pgear      # Gear Range
           if gear = 0, pgear_calc
           if gear <> 0, *sgear

prange     # Find spindle range
           gear = mi3$
           if use_gear = yes$, pgear

pstool     # Pre-stage tool
           if prv_t$ <> next_tool$, next_tool$

pfr        # Feedrate W/O Negative Feedrates
           if fr$ > 0, fr$

pcoolon    # Coolant on
           if coolant$ > 0, "M08", !coolant$

pcooloff   # Coolant off
           if prv_coolant$ > 0, "M09", !coolant$
           prv_coolant$ = 0

psg00      # Output "G0" via String Select Function to maintain modality
           gcode$ = 0
           *sgcode

# --------------------------------------------------------------------------
# Postline - Names are pre-assigned except for partial lines which are
#            called from pre-assigned lines (Ex. pt)
# --------------------------------------------------------------------------
pheader$    # File header
           "%", e$

psof0$      # Start of file for tool zero
           psof$

psof$       # Start of file for non-zero tool number
           pinit
           pcan
           pcan1, n$, "G90", "G70", "G0", "T0", *xh$, *yh$, "Z0.", strcantext, e$
           pcan2
           n$, *t$, pfr, e$
           n$, *spdlon, e$
           n$, pcoolon, e$
           savefr = fr$
           if rotaxis$ <> 0, linarc$ = yes$   # when in rotary break up arcs
           if rotaxis$ = 0,  linarc$ = no$

ptlchg0$    # Null tool change
           pr
           if prv_c$ <> c$, protary
           if prv_ss$ <> ss$, n$, ss$, e$
           if rotaxis$ <> 0, linarc$ = yes$   # when in rotary break up arcs
           if rotaxis$ = 0,  linarc$ = no$

ptlchg$     # Tool change
           n$, "G0", "T0", "Z0", pcooloff, e$
           n$, "M5", e$
           pcan
           pcan1, n$, xh$, yh$, strcantext, e$
           pcan2
           pinit
           n$, *t$, pfr, e$
           n$, *spdlon, e$
           n$, pcoolon, e$
           savefr = fr$
           if rotaxis$ <> 0, linarc$ = yes$   # when in rotary break up arcs
           if rotaxis$ = 0,  linarc$ = no$

peof0$      # End of file for tool zero
           peof$

peof$       # End of file for non-zero tool
           n$, "G0", "T0", "Z0", pcooloff, e$
           n$, "M5", e$
           n$, *xh$, *yh$, e$
           n$, "M2", e$
           "%", e$

# --------------------------------------------------------------------------
# Axis Motion Definition Section
# --------------------------------------------------------------------------
pm1453     # If next move is a rapid output M1453
           if nextop$ = 0, "M1453"

pisitamove # Check to make sure not toolchange ...
           if nextop$ < 4, "M1452"

pm1452     # If the next line is linear output M1452
           if nextop$ <> 0, pisitamove

protaxis1  # Substitute Axis X/Y with Rotary axis
           fr3 = mr1$
           ratio = mr2$
           if vtol$ > abs(xangle), xangle = vtol$
           ratio2 = y$ / xangle
           if ratio2 >= ratio, fr$ = fr3
           if ratio2 < ratio, fr$ = savefr
           pcan1, n$, sccomp, sgcode, xangle, y$, z$, pfr, strcantext, e$
           if rapid = 1, n$, pm1452
           if rapid = 0, n$, pm1453
           rapid = 0

protaxis2  # Substitute Axis X/Y with Rotary axis
           fr3 = mr1$
           ratio = mr2$
           if vtol$ > abs(yangle), yangle = vtol$
           ratio2 = x$ / yangle
           if ratio2 >= ratio, fr$ = fr3
           if ratio2 < ratio, fr$ = savefr
           pcan1, n$, sccomp, sgcode, x$, yangle, z$, pfr, strcantext, e$
           if rapid = 1, n$, pm1452
           if rapid = 0, n$, pm1453
           rapid = 0


protaxis   # Substitute Axis X/Y with Rotary axis
           if gcode$ > 1, "(ERROR - ARCS MUST BROKEN)", e$, ex$
           xangle = x$ * 2 * rad2deg$ / rotdia$
           yangle = y$ * 2 * rad2deg$ / rotdia$
           pcan
           if rotaxis$ = 1, protaxis1
           if rotaxis$ = 2, protaxis2
           pcan2

prapidm    # Linear line movement - at rapid feedrate
           pcan
           n$, sccomp, e$
           pcan1, n$, sgplane, sgcode, x$, y$, z$, !fr$, strcantext, e$
           pcan2
           n$, pm1452, e$

prapid$     # Linear line movement - at rapid feedrate
           rapid = 1
           if rotaxis$ <> 0, protaxis
           if rotaxis$ = 0, prapidm

pzrapid$    # Linear movement in Z axis only - at rapid feedrate
           pcan
           pcan1, n$, sccomp, sgcode, z$, strcantext,e$
           pcan2

plinm      # Linear line movement - at feedrate
           pcan
           n$, sccomp, e$
           pcan1, n$, sgcode, x$, y$, z$, pfr, strcantext, e$
           pcan2
           n$, pm1453, e$

plin$       # Linear line movement - at feedrate
           if rotaxis$ <> 0, protaxis
           if rotaxis$ = 0, plinm

pz$         # Linear movement in Z axis only - at feedrate
           pcan
           pcan1, n$, ptllncomp, sgcode, z$, pfr, strcantext,e$
           pcan2

pcirm      # Circular interpolation
           pcan
           n$, sgplane, e$
           n$, sccomp, e$
           pcan1, n$, sgcode, x$, y$, z$, pijk, pfr, strcantext, e$
           pcan2
           n$, pm1453, e$

pcir$       # Circular interpolation
           if rotaxis$ <> 0, protaxis
           if rotaxis$ = 0, pcirm

# --------------------------------------------------------------------------
# Drilling Definition Section
# --------------------------------------------------------------------------
pdrillref  # Determine G98 or G99
           n$, psg00, *x$, *y$, e$
           if initht$ <> refht$, drillref = 98
           if initht$ = refht$, drillref = 99

pdwell     # Determine whether to output dwell
           if dwell$ <> 0, *dwell$

pdrill$     # Canned Drill Cycle
           n$, *frplunge$, e$
           n$, *refht$, e$
           n$, *dwell$, e$
           n$, *initht$, e$
           n$, *sgdrill, *x$, *y$, *depth$, e$

ppeck$      # Canned Peck Drill Cycle
           n$, *frplunge$, e$
           n$, *refht$, e$
           n$, *initht$, e$
           n$, *peck2$, e$
           n$, *sgdrill, *x$, *y$, *depth$, e$

pchpbrk$    # Canned Chip Break Cycle
           n$, *frplunge$, e$
           n$, *refht$, e$
           n$, *initht$, e$
           n$, *peck2$, e$
           n$, *sgdrill, *x$, *y$, *depth$, e$

ptap$       # Canned Tap Cycle
           n$, *frplunge$, e$
           n$, *refht$, e$
           n$, *initht$, e$
           n$, *sgdrill, *x$, *y$, *depth$, e$

pbore1$     # Canned Bore #1 Cycle
           n$, *frplunge$, e$
           n$, *refht$, e$
           n$, *dwell$, e$
           n$, *initht$, e$
           n$, *sgdrill, *x$, *y$, *depth$, e$

pbore2$     # Canned Bore #2 Cycle
           n$, *frplunge$, e$
           n$, *refht$, e$
           n$, *initht$, e$
           n$, *sgdrill, *x$, *y$, *depth$, e$

pmisc1$     # Canned Misc #1 Cycle (User Option)

pmisc2$     # Canned Misc #2 Cycle (User Option)

pdrill_2$   # Canned Drill Cycle
           n$, x$, y$, depth$, e$

ppeck_2$    # Canned Peck Drill Cycle
       pdrill_2$

pchpbrk_2$  # Canned Chip Break Cycle
       pdrill_2$

ptap_2$     # Canned Tap Cycle
       pdrill_2$

pbore1_2$   # Canned Bore #1 Cycle
       pdrill_2$

pbore2_2$   # Canned Bore #2 Cycle
       pdrill_2$

pmisc1_2$   # Canned Misc #1 Cycle
       pdrill_2$

pmisc2_2$   # Canned Misc #2 Cycle
       pdrill_2$

pcanceldc$  # Cancel canned drill cycle
           n$, "G80",e$

pcancelcc$  # Cancel cutter comp.
           n$, "G40", e$

pwrtt$      # Tool table line format
           #"( ", *sopnote, " OPER W /", t, " ",tldia, " DIA )"

# --------------------------------------------------------------------------
# Canned Text
# --------------------------------------------------------------------------
pcan            #Canned text - before output call
      strcantext = sblank
      if cant_no$ > 0,
        [
        if cant_pos1$ = 0, pcant_1
        if cant_pos2$ = 0, pcant_2
        if cant_pos3$ = 0, pcant_3
        if cant_pos4$ = 0, pcant_4
        if cant_pos5$ = 0, pcant_5
        if cant_pos6$ = 0, pcant_6
        if cant_pos7$ = 0, pcant_7
        if cant_pos8$ = 0, pcant_8
        if cant_pos9$ = 0, pcant_9
        if cant_pos10$ = 0, pcant_10
        n$, strcantext, e$
        strcantext = sblank
        ]

pcan1           #Canned text - with move
      strcantext = sblank
      if cant_no$ > 0,
        [
        if cant_pos1$ = 1, pcant_1
        if cant_pos2$ = 1, pcant_2
        if cant_pos3$ = 1, pcant_3
        if cant_pos4$ = 1, pcant_4
        if cant_pos5$ = 1, pcant_5
        if cant_pos6$ = 1, pcant_6
        if cant_pos7$ = 1, pcant_7
        if cant_pos8$ = 1, pcant_8
        if cant_pos9$ = 1, pcant_9
        if cant_pos10$ = 1, pcant_10
        ]
      if cstop$, strcantext = strcantext + sm00
      if cgstop$, strcantext = strcantext + sm01
      #Output of strcantext occurs at the end of the output line

pcan2           #Canned text - after output call
      strcantext = sblank
      if cant_no$ > 0,
        [
        if cant_pos1$ = 2, pcant_1
        if cant_pos2$ = 2, pcant_2
        if cant_pos3$ = 2, pcant_3
        if cant_pos4$ = 2, pcant_4
        if cant_pos5$ = 2, pcant_5
        if cant_pos6$ = 2, pcant_6
        if cant_pos7$ = 2, pcant_7
        if cant_pos8$ = 2, pcant_8
        if cant_pos9$ = 2, pcant_9
        if cant_pos10$ = 2, pcant_10
        n$, strcantext, e$
        strcantext = sblank
        ]

pcant_1         #Canned text - output call
      cantext$ = cant_val1$
      pcant_out

pcant_2         #Canned text - output call
      cantext$ = cant_val2$
      pcant_out

pcant_3         #Canned text - output call
      cantext$ = cant_val3$
      pcant_out

pcant_4         #Canned text - output call
      cantext$ = cant_val4$
      pcant_out

pcant_5         #Canned text - output call
      cantext$ = cant_val5$
      pcant_out

pcant_6         #Canned text - output call
      cantext$ = cant_val6$
      pcant_out

pcant_7         #Canned text - output call
      cantext$ = cant_val7$
      pcant_out

pcant_8         #Canned text - output call
      cantext$ = cant_val8$
      pcant_out

pcant_9         #Canned text - output call
      cantext$ = cant_val9$
      pcant_out

pcant_10        #Canned text - output call
      cantext$ = cant_val10$
      pcant_out

pcant_out       #Canned text - build the string for output
      #Assign string select type outputs
      #Build the cantext string
      if cantext$ = 1, strcantext = strcantext + sm00
      if cantext$ = 2, strcantext = strcantext + sm01
      if cantext$ > 2,
        [
        strtextno = no2str(cantext$)
        strcantext = strcantext + strm + strtextno
        ]

