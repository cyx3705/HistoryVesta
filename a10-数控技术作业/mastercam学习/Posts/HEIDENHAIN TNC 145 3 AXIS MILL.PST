	<control>
		<control_label>CTRL_MILL|DEFAULT</control_label>
		<language>en-US</language>
		<misc_integers>
			<misc_1>
				<text>Output M90 on 3D Toolpaths (1 = yes)</text>
			</misc_1>
		</misc_integers>
		<misc_reals>
			<misc_1>
				<text>""</text>
			</misc_1>
			<misc_2>
				<text>""</text>
			</misc_2>
			<misc_3>
				<text>""</text>
			</misc_3>
			<misc_4>
				<text>""</text>
			</misc_4>
			<misc_5>
				<text>""</text>
			</misc_5>
			<misc_6>
				<text>""</text>
			</misc_6>
		</misc_reals>
		<simple_drill>
			<description>
				<text>Drill (Simple)</text>
			</description>
			<feed_rate>
				<text>Feedrate</text>
			</feed_rate>
			<clearance>
				<text>Initial Rapid height</text>
			</clearance>
			<retract>
				<text>Setup height (Equal to Rapid Height)</text>
			</retract>
			<depth>
				<text>Depth</text>
			</depth>
			<first_peck>
				<text>""</text>
			</first_peck>
			<subsequent_peck>
				<text>""</text>
			</subsequent_peck>
			<peck_clearance>
				<text>""</text>
			</peck_clearance>
			<retract_amount>
				<text>""</text>
			</retract_amount>
		</simple_drill>
		<peck_drill>
			<description>
				<text>Peck drill (Simple)</text>
			</description>
			<feed_rate>
				<text>Feedrate</text>
			</feed_rate>
			<clearance>
				<text>Initial Rapid height</text>
			</clearance>
			<retract>
				<text>Setup height (Equal to Rapid Height)</text>
			</retract>
			<depth>
				<text>Depth</text>
			</depth>
			<first_peck>
				<text>Pecking Depth</text>
			</first_peck>
			<subsequent_peck>
				<text>""</text>
			</subsequent_peck>
			<peck_clearance>
				<text>""</text>
			</peck_clearance>
			<retract_amount>
				<text>""</text>
			</retract_amount>
		</peck_drill>
		<chip_break>
			<description>
				<text>""</text>
			</description>
			<feed_rate>
				<text>Feedrate</text>
			</feed_rate>
			<dwell>
				<text>Dwell at bottom</text>
			</dwell>
			<clearance>
				<text>Initial Rapid height</text>
			</clearance>
			<retract>
