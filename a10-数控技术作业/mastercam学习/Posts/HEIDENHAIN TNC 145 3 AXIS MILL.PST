[POST_VERSION] #DO NOT MOVE OR ALTER THIS LINE# V22.00 P0 E1 W22.00 T1550094730 M22.00 I0 O0
scncpost_revision     := "22.80" # Internal revision number for use by CNC Software only.  Please do not change this number.
scustpost_revision    := "0"  # Revision number for use by Resellers or customers.
# Post Name           : HEIDENHAIN TNC 145 3 AXIS MILL
# Product             : MILL
# Machine Name        : BRIDGEPORT
# Control Name        : HEIDENHEAIN TNC 145
# Description         : GENERIC TNC 145 INCH POST
# Associated Post     :
# Mill/Turn           : NO
# 4-axis/Axis subs.   : NO
# 5-axis              : NO
# Executable          : mp.dll
#
# WARNING: THIS POST IS GENERIC AND IS INTENDED FOR MODIFICATION TO
# THE MACHINE TOOL REQUIREMENTS AND PERSONAL PREFERENCE.
#
# Associated File List$
#
# HEIDENHAIN TNC 145 3 AXIS MILL.mcam-control
# HEIDENHAIN TNC 145 3 AXIS MILL.mcam-mmd
#
# Associated File List$
#
# --------------------------------------------------------------------------
# Revision log:
# --------------------------------------------------------------------------
# 25/05/96 Initial Post Set Up
# 27/09/96 Drilling changed to allow for incremetal drilling
# 10/10/96 Nonmodal post for 145 controllers
# 19/10/96 Don't Use this post for drip feeding (label calls)
# CNC      Updated to X6
# CNC 06/05/18  -  (21.80) Initial post update for Mastercam 2019
# CNC 02/14/19  -  (22.80) Initial post update for Mastercam 2020
#
# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# Features:
# --------------------------------------------------------------------------
#---------------
# USERS NOTE
#-------------------------------------------------------------------------
# Metric Post !
#
#----------------
# CABLING:
#-------------------------------------------------------------------------
#
# Set Param 5020.0 to 168 (7 Data Even parity 1 Stop bit)
# Set Param 5020.1 to 0
# To use FE mode (ie TNC software)
# No changes in controller Machine Parameters required. Use Hiedenhain cabling.

# END_HEADER$
#
# --------------------------------------------------------------------------
#   SWITCHES
# --------------------------------------------------------------------------
fastmode$ : no$           # Fast MP Processing (Ver 6)
nonmodal  : yes$          # Modal switch for R F M on every line
# --------------------------------------------------------------------------
#   DEBUGGING AIDS
# --------------------------------------------------------------------------
bug1$          : 1     # 1 = Output post to screen - 2 = output leader to screen
bug2$          : 0     # Add postline label to each line at column 'bug2'
bug4$          : 0     # Add -.nci line no. to each line? yes/no
whatno$        : yes$  # Ignore whatline branches to plin1 etc.?#
linktolvar$    : 1     #Associate X tolerance variables to V9- variable?
linkplnvar$    : 1     #Associate X plane specific variables to V9- variable?
cant_tlchng$   : 1     #Ignore cantext entry on move with tlchng_aft?
newglobal$     : 0     #Enable error checking for global variables?
strtool_v7$    : 2     #Use V7+ tool name?
get_1004$      : 1     #Find gcode 1004 with getnextop?
skp_lead_flgs$ : 1     #Do NOT use V9+ style contour flags?
rpd_typ_v7$    : 1     #Use V7+ style contour flags/processing?

# --------------------------------------------------------------------------
# Format Statements - i=incr., n=nonmodal, l=leave ldg., t=leave trlg.
# --------------------------------------------------------------------------
fs  1  +1,4lt
fs  2  +1,4ltn
fs  3  4 0n
fs  4  +4,3t
# --------------------------------------------------------------------------
# Format Assignments
# --------------------------------------------------------------------------
# fmt  X 1 x  - x, y, z, i, j, k, xh, yh, zh, xr, yr, zr, mr ,xp, yp
#               are init. fs 1, with 'normal' prefix letter
# --------------------------------------------------------------------------
# --------------------------------------------------------------------------
# Axis output formats - Linear
# --------------------------------------------------------------------------
fmt  "X" 1 x$        # X Axis Pos
fmt  "Y" 1 y$        # Y Axis Pos
fmt  "Z" 1 z$        # Z Axis Pos
fmt  "X" 2 xr$       # X Rapid Pos
fmt  "Y" 2 yr$       # Y Rapid Pos
fmt  "Z" 2 zr$       # Z Rapid Pos
fmt  "X" 1 xh$       # X Home Pos
fmt  "Y" 1 yh$       # Y Home Pos
fmt  "Z" 1 zh$       # Z Home Pos
# --------------------------------------------------------------------------
# Axis output formats - Circular
# --------------------------------------------------------------------------
fmt  "X" 1 i$        # Arc center description in X
fmt  "Y" 1 j$        # Arc center description in Y
fmt  "Z" 1 k$        # Arc center description in Z
fmt    1 xc$         # Arc Center X
fmt    1 yc$         # Arc Center Y
fmt    1 sa$         # Start angle for arc
fmt    1 so$         # Start octant for arc
fmt    1 ea$         # End angle for arc
fmt    1 eo$         # End octant for arc
fmt    1 sweep$      # Angle between start and end of arc
# --------------------------------------------------------------------------
# Program & Sequence number format
# --------------------------------------------------------------------------
fmt    3 progno$     # Program number
fmt    3 seqno$      # Starting Sequence No.
fmt    3 seqinc$     # Sequence No.Increment
fmt    3 n$          # Main Program Seq No's
# --------------------------------------------------------------------------
# Tool format
# --------------------------------------------------------------------------
fmt    3 t$          # Tool No
fmt  "R" 2 tlrad$    # Tool Radius
fmt  "D" 3 tloffno$  # Diameter Offset No
fmt  "L" 2 tlngno$   # Length Offset No
fmt  "L" 2 length    # Length offset for tool Used in Question 1
# --------------------------------------------------------------------------
# Spindle Speeds & Feedrate output formats
# --------------------------------------------------------------------------
fmt  "S" 3 ss$           # Spindle Speed
fmt  "S" 3 selspin       # Spindle Dir
fmt    3 spprev          # Hold previous selspin value for spin change
fmt  "F" 3 fr$           # Feedrate
fmt    3 dirchg$         # Feerate Accel/Decel Flag
# --------------------------------------------------------------------------
# Cutter Comp formats
# --------------------------------------------------------------------------
fmt    3 ccomp$          # Modal format for ccomp
fmt    3 cc$             # Cutter Comp.
# --------------------------------------------------------------------------
# Miscellaneous output formats
# --------------------------------------------------------------------------
fmt    3 plane$      # Modal plane code selector
fmt    3 wcs         # make Work Coord. string 'sgwcs' non-modal
fmt    3 spdlon      # Spindle On code
fmt    3 gcode$      # Format linear G-code selector for modality only
fmt  "C" 3 coolant$  # Coolant
# --------------------------------------------------------------------------
# Drill variable formats
# --------------------------------------------------------------------------
fmt    3 drillcyc$   # Canned Drill Cycle = 0 to 7
fmt    3 drillcur$   # Drill with current cycle flag (=1 if true)
fmt    2 dwell$      # Dwell
fmt    1 initht$     # Initial Height (Rapid height
fmt    2 refht$      # Setup Height (absolute)
fmt    2 setup       # Setup height (calculated incremental)
fmt    2 depth$      # Depth (absolute)
fmt    2 zinc        # Depth (calculated incremental)
fmt    2 peck1$      # Peck depth (positive)
fmt    2 peck2$      # Peck Reduction (positive)
fmt    2 peckclr$    # Used for minimum peck amount
fmt  3 retr$         # Used for number of chip breaks
fmt    3 frplunge$   # Plunge feedrate in drill cycles
fmt  3 fpeck         # Plunge feedrate in pocket mill cycles
# --------------------------------------------------------------------------
# Formulas - Use ':' instead of '=' to initialize variables
# --------------------------------------------------------------------------
true         : 1
false        : 0
plane$       : 0        # Initialize plane code to suppress first G17 (XY plane)
planek       : 0        # Check plane
opcode$      : 0
spaces$      : yes$
auxprg$      : no$      #
omitseq$     : no$      # Omit sequence no.?
seqmax$      : 99999    # Max Line number
skipmotest$  : no$      #
breakarcs$   : no$      # Break arcs into quadrants? no
arctype$     : 1        # Arc center 1=abs, 2=inc, 3=st-cen, 4=unsigned inc.
nobrk$       : no$      # Break 3 axis moves into XY then Z
getnextop$   : 1        # Access to nextop, nextccomp, nextdc
bldnxtool$   : yes$     # Build next tool table
tooltable$   : 1        # Output tool table  0=no, 1=before header, 2=after header
progname$    : 1        # Force program name into capitals
null_drill   : 0        # Flag for null tool change in drilling
retract      : 1        # Force retract to safe height in drilling
cycle        : 0        # Drilling variables
zinc         : 0
setup        : 0
prv_zinc     : 0
prv_setup    : 0
last_setup   : 0
last_zinc    : 0
fr_unchanged : false
# --------------------------------------------------------------------------
# User Defined variables
# --------------------------------------------------------------------------
sdef  : "CYCL DEF"       # Initialize
scall : "CYCL CALL"      # Initialize
srap  : "F9999"          # Initialize
screp : "M99"            # Initialize
fmt  "X" 2 mr1$          # X min BLK FORM
fmt  "X" 2 mr4$          # X max BLK FORM
fmt  "Y" 2 mr2$          # Y min BLK FORM
fmt  "Y" 2 mr5$          # Y max BLK FORM
fmt  "Z" 2 mr3$          # Z min BLK FORM
fmt  "Z" 2 mr6$          # Z max BLK FORM
# --------------------------------------------------------------------------
#  USE CANNED CYCLES?
# --------------------------------------------------------------------------
usecandrill$ : yes$       # Use canned cycle for Drill
usecanpeck$  : yes$       # Use canned cycle for Peck
usecanchip$  : yes$       # Use canned cycle for Chip Break
usecantap$   : yes$       # Use canned cycle for Tap
usecanbore1$ : yes$       # Use canned cycle for Bore1
usecanbore2$ : yes$       # Use canned cycle for Bore2
usecanmisc1$ : yes$       # Use canned cycle for Misc1
usecanmisc2$ : yes$       # Use canned cycle for Misc2
# --------------------------------------------------------------------------
# Lookup table definitions - for Math Functions FLOOK and FRANGE
# --------------------------------------------------------------------------
#
# --------------------------------------------------------------------------
# Strings - String labels must start with 's' - they are not pre-assigned
# --------------------------------------------------------------------------
sg00    : "L"    # Linear movement at rapid feedrate G code
sg01    : "L"    # Linear movement at feedrate G code
sg02    : "C"    # Circular interpolation CW G code
sg03    : "C"    # Circular interpolation CCW G code
sgcode  : ""      # Target string for linear/circular motion G code

fstrsel  sg00 gcode$ sgcode 4 -1# Select motion G code string

# --------------------------------------------------------------------------
# Ask Questions at RUN time
# --------------------------------------------------------------------------
fq 1 length "Enter length offset for tool //t$//"
# --------------------------------------------------------------------------
# POSTBLOCKS, USER DEFINED
# End a line with ',' to continue on the next line
# End a line with ',e' to generate carriage return line feed
# --------------------------------------------------------------------------

pM90        # Output M90 code on 3D Toolpaths

        if mi1$ = 1, "M90"
            else, "M"


pcc1         # Select Cutter Compensation

        if cc$ = 0, "R0" #Cutter Comp Off
        if cc$ = 40, "R0"    #Cancel Comp
        if cc$ = 41, "RL"    #Left Comp
        if cc$ = 42, "RR"    #Right Comp
        if cc$ = 140, "R0"   #Cancel Comp with last move


pcc         # Select Cutter Compensation

        if cc$ <> prv_cc$, pcc1
        if ( cc$ = prv_cc$) & nonmodal, "R"

pspdl      # spindle state This makes M Code Non Modal

        if (opcode$ > 6 & fr_unchanged), pM90
            else, "M"

pfrapid     # Rapid Feedrate

         srap, !fr$
         fr_unchanged = false

punchanged

        if nonmodal, "F"
        !fr$
        fr_unchanged = true

pchanged

            fr$

pfr         # Feedrate

        if (fr$ = prv_fr$) | (fr$ = -1), punchanged
            else, pchanged


# --------------------------------------------------------------------------
# POSTBLOCKS, PRE-DEFINED
# --------------------------------------------------------------------------
pheader$     # File header

        " ", e$
        n$, "BEGIN PGM ", progno$, "INCH", e$

psof0$       # Start of file for tool zero                        1001

        psof$

psof$        # Start of file for non-zero tool number             1001

        n$, "LBL 1", e$
        n$, "TOOL CALL 0 Z S50", e$
        n$, "L", *zh$, "R0 F9999 M05", e$
        n$, "L", *xh$, *yh$, "R0 F9999 M", e$
        n$, "LBL 0", e$
        n$, "STOP M25", e$
        q1
        n$, "TOOL DEF ", t$, length, tlrad$, e$
        n$, "TOOL CALL ", t$, "Z", *ss$, e$
        n$, "L", *xr$, *yr$, "R0", srap, "M13", e$
        n$, "L", *zr$, "R", srap, "M", e$

ptlchg0$     # Null tool change                                   1002

        if opcode$ = 3, null_drill = 1
        !opcode$, !coolant$

ptlchg$      # Tool change                                        1002

        n$, "L R F M09", e$    #Turn off collant
        n$, "CALL LBL 1 REP", e$
        n$, "STOP M25", e$
        q1
        n$, "TOOL DEF ", t$, length, tlrad$, e$
        n$, "TOOL CALL ", t$, "Z", *ss$, e$
        n$, "L", *xr$, *yr$, "R", srap, "M13", e$
        n$, "L", *zr$, "R", srap, "M", e$
        !opcode$, !coolant$

peof0$       # End of file for tool zero                          1003

        peof$

peof$        # End of file for non-zero tool                      1003

        n$, "L R F M09", e$    #Turn off collant
        n$, "CALL LBL 1 REP", e$
        n$, "STOP M25", e$
        n$, "END PGM ", progno$, "INCH", e$
        3, e$
# --------------------------------------------------------------------------
# Axis Motion
# --------------------------------------------------------------------------

prapid$     # Linear line movement - at rapid feedrate              0

        n$, sgcode, x$, y$, z$, pcc, pfrapid, pspdl, e$

pzrapid$    # Linear movement in Z axis only - at rapid feedrate    0

        n$, sgcode, z$, pcc, pfrapid, pspdl, e$


prot$        # 4th AXIS Called by 1014 in NCI file

        n$, "Custom post required for rotary axis", e$

plin$        # Linear line movement - at feedrate                    1

        n$, sgcode, x$, y$, z$, pcc, pfr, pspdl, e$

pz$          # Linear movement in Z axis only - at feedrate          1

        n$, sgcode, z$, pcc, pfr, pspdl, e$

pplanechk0    # Check for change of plane XY, YZ or XZ

        if plane$ = 0, n$, "TOOL CALL ", *t$, "Z", e$
        if plane$ = 1, n$, "TOOL CALL ", *t$, "X", e$
        if plane$ = 2, n$, "TOOL CALL ", *t$, "Y", e$
        planek = plane$

pplanechk     # Check for change of plane XY, YZ or XZ

        if plane$ <> planek, pplanechk0

pcircw        # Circular interpolation clockwise

        pplanechk
        if plane$ = 0, n$, "CC", *i$, *j$, e$
        if plane$ = 0, n$, sgcode, x$, y$, "DR-", pcc, pfr, pspdl

        if plane$ = 1, n$, "CC", *j$, *k$, e$
        if plane$ = 1, n$, sgcode, y$, z$, "DR-", pcc, pfr, pspdl

        if plane$ = 2, n$, "CC", *i$, *k$, e$
        if plane$ = 2, n$, sgcode, x$, z$, "DR-", pcc, pfr, pspdl


pcircc        # Circular interpolation counter clockwise

        pplanechk
        if plane$ = 0, n$, "CC", *i$, *j$, e$
        if plane$ = 0, n$, sgcode, x$, y$, "DR+", pcc, pfr, pspdl

        if plane$ = 1, n$, "CC", *j$, *k$, e$
        if plane$ = 1, n$, sgcode, y$, z$, "DR+", pcc, pfr, pspdl

        if plane$ = 2, n$, "CC", *i$, *k$, e$
        if plane$ = 2, n$, sgcode, x$, z$, "DR+", pcc, pfr, pspdl

pcir$        # Circular interpolation                                2

        if gcode$ = 2, pcircw, e$
        if gcode$ = 3, pcircc, e$

# --------------------------------------------------------------------------
# Drilling
# --------------------------------------------------------------------------
pnull_drill
        null_drill = 0
        n$, "L", *x$, *y$, "R", srap, "M", e$
        n$, "L Z", *refht$, "R", srap, "M", e$

psafedrill_2
        pnull_drill
        n$, scall, e$

pcheck_cycle        #This code checks previous drill cycle and compares it with current one
        cycle = 0
        last_setup = prv_setup
        last_zinc = prv_zinc
        setup = zdrl$- refht$
        zinc = depth$ - zdrl$
        !setup, !zinc
        if ((setup = last_setup) & (zinc = last_zinc)), cycle = 1

pcycle_def1
        n$, sdef, "1.0 PECKING", e$
        n$, sdef, "1.1 SET UP ", *setup, e$
        n$, sdef, "1.2 DEPTH ", *zinc, e$
        n$, sdef, "1.3 PECKG ", *zinc, e$
        n$, sdef, "1.4 DWELL ", *dwell$, e$
        n$, sdef, "1.5 F", *frplunge$, e$

pcycle_def2
        n$, sdef, "1.0 PECKING", e$
        n$, sdef, "1.1 SET UP ", *setup, e$
        n$, sdef, "1.2 DEPTH ", *zinc, e$
        n$, sdef, "1.3 PECKG ", *peck1$, e$
        n$, sdef, "1.4 DWELL ", *dwell$, e$
        n$, sdef, "1.5 F", *frplunge$, e$

pcycle_def3
        n$, sdef, "2.0 TAPPING", e$
        n$, sdef, "2.1 SET UP ", *setup, e$
        n$, sdef, "2.2 DEPTH ", *zinc, e$
        n$, sdef, "2.3 DWELL ", *dwell$, e$
        n$, sdef, "2.4 F", *frplunge$, e$

pcycle_def4
        n$, sdef, "4.0 POCKET MILLING", e$
        n$, sdef, "4.1 SET UP ", *setup, e$
        n$, sdef, "4.2 DEPTH ", *zinc, e$
        n$, sdef, "4.3 PECKING DEPTH ", *peck1$, "F", *retr$, e$
        n$, sdef, "4.4 X", *peck2$, e$
        n$, sdef, "4.5 Y", *peckclr$, e$
        n$, sdef, "4.6 F", *frplunge$, "DR+", e$

pcycle_def5
        n$, sdef, "5.0 CIRCULAR POCKET", e$
        n$, sdef, "5.1 SET UP ", *setup, e$
        n$, sdef, "5.2 DEPTH ", *zinc, e$
        n$, sdef, "5.3 PECKING DEPTH ", *peck1$, "F", *fpeck, e$
        n$, sdef, "5.4 CIRCLE RADIUS ", *peck2$, e$
        n$, sdef, "5.5 F", *frplunge$, "DR+", e$

pdrill$          # Canned Drill Cycle 200

        pcheck_cycle
        if null_drill, pnull_drill
        if cycle = 0, pcycle_def1
        n$, scall, e$

ppeck$            # Canned Peck Drill Cycle 200

        pcheck_cycle
        if null_drill, pnull_drill
        if cycle = 0, pcycle_def2
        n$, scall, e$

pchpbrk$          # Universal Drill Cycle (chip break in MasterCam)

#       no code for this (only of any use on 370 and higher controller)

ptap$             # Canned Tap Cycle

        pcheck_cycle
        if null_drill, pnull_drill
        if cycle = 0, pcycle_def3
        n$, scall, e$

pbore1$          # Canned Bore #1

pbore2$          # Canned Bore #2

pmisc1$          # Rectangular Pocket cycle

        pcheck_cycle
        if null_drill, pnull_drill
        if cycle = 0, pcycle_def4
        n$, scall, e$

pmisc2$          #

        fpeck = peckclr$
        pcheck_cycle
        if null_drill, pnull_drill
        if cycle = 0, pcycle_def5
        n$, scall, e$

pdrill_2$        # Canned Drill Cycle

        psafedrill_2


ppeck_2$         # Canned Peck Drill Cycle

        pdrill_2$

pchpbrk_2$       # Canned Chipbreak Cycle

        pdrill_2$

ptap_2$              # Canned Tapping Cycle

        pdrill_2$

pbore1_2$        # Canned Bore #1 Cycle

        pdrill_2$

pbore2_2$        #

        pdrill_2$

pmisc1_2$        #

        pdrill_2$

pmisc2_2$            #

        pdrill_2$

pcanceldc$   # Cancel canned drill cycle
        # Retract cutter to safe

        n$, "L", *zh$, "R", srap, "M", e$
        !z$

pcancelcc$   # Cancel cutter comp.

# --------------------------------------------------------------------------
# ToolTable Info
# --------------------------------------------------------------------------

pwrtt$    # Tool table line format

#       if t >= 0, n, "TOOL DEF ", t, "L0", tlrad
# --------------------------------------------------------------------------
# Numbered questions for Mastercam --  Used by Mill 6
# --------------------------------------------------------------------------
38. Rapid feedrate? 9999.0
80. Communications port number for receive and transmit (1 or 2) ? 1
81. Data rate (110,150,300,600,1200,2400,4800,9600,14400,19200,38400)? 2400
82. Parity (E/O/N)? E
83. Data bits (7 or 8)? 7
84. Stop bits (1 or 2)? 1
85. Strip line feeds? N
86. Delay after end of line (seconds)? 0.0
87. Ascii, Eia, or Binary (A/E/B)? A
88. Echo keyboard to screen in terminal emulation? n
89. Strip carriage returns? N
90. Drive and subdirectory for NC and Material files? C:\MILL6\NC
91. Name of executable post processor? MP
92. Name of reverse post processor? RP
93. Reverse post PST file name? RPHEID
100. Number of places BEFORE the decimal point for sequence numbers? 3
101. Number of places AFTER the decimal point for sequence numbers? 0
103. Maximum spindle speed? 10000
107. Average time for tool change (seconds)? 2.0
110. Default tool library? TOOLSM.MTL

# --------------------------------------------------------------------------
# Default Miscellaneous Real Values
# --------------------------------------------------------------------------
201. Default miscellaneous real variable 1 (mr1)? 0.0
202. Default miscellaneous real variable 2 (mr2)? 0.0
203. Default miscellaneous real variable 3 (mr3)? 0.0
204. Default miscellaneous real variable 4 (mr4)? 0.0
205. Default miscellaneous real variable 5 (mr5)? 0.0
206. Default miscellaneous real variable 6 (mr6)? 0.0
207. Default miscellaneous real variable 7 (mr7)? 0.0
208. Default miscellaneous real variable 8 (mr8)? 0.0
209. Default miscellaneous real variable 9 (mr9)? 0.0
210. Default miscellaneous real variable 10 (mr10)? 0.0

# --------------------------------------------------------------------------
# Default Miscellaneous Integer Values
# --------------------------------------------------------------------------
301. Miscellaneous integer variable 1 (mi1)? 0
302. Miscellaneous integer variable 2 (mi2)? 0
303. Miscellaneous integer variable 3 (mi3)? 0
304. Miscellaneous integer variable 4 (mi4)? 0
305. Miscellaneous integer variable 5 (mi5)? 0
306. Miscellaneous integer variable 6 (mi6)? 0
307. Miscellaneous integer variable 7 (mi7)? 0
308. Miscellaneous integer variable 8 (mi8)? 0
309. Miscellaneous integer variable 9 (mi9)? 0
