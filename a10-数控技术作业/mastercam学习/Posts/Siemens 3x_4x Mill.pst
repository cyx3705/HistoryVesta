			</depth>
			<first_peck>
				<text>""</text>
			</first_peck>
			<subsequent_peck>
				<text>""</text>
			</subsequent_peck>
			<peck_clearance>
				<text>""</text>
			</peck_clearance>
			<retract_amount>
				<text>[FR]Retract Feedrate</text>
			</retract_amount>
			<shift>
				<text>""</text>
			</shift>
		</bore1>
		<bore2>
			<description>
				<text>Boring</text>
			</description>
			<dwell>
				<text>[DT]Dwell@depth-scnds</text>
			</dwell>
			<depth>
				<text>[Z1]Depth</text>
			</depth>
			<first_peck>
				<text>Lift-off? [0=Yes,1=No]</text>
