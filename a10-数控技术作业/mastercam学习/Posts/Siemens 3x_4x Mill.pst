[POST_VERSION] #DO NOT MOVE OR ALTER THIS LINE# V22.00 P0 E1 W22.00 T1555359063 M22.00 I0 O1
scncpost_revision     := "22.87" # Internal revision number for use by CNC Software only.  Please do not change this number.
scustpost_revision    := "0"  # Revision number for use by Resellers or customers.
# Post Name           : Siemens 3x_4X Mill.pst
# Product             : Mill
# Machine Name        : Generic
# Control Name        : Siemens 840D / 828D / 808D (see 'control_model' switch in post)
# Description         : Siemens 3 Axis and 4 Axis Mill Post for 840D / 828D / 808D controls
# 4-axis/Axis subs.   : Yes
# 5-axis              : No
# Subprograms         : No
# Executable          : mp.dll
#
# WARNING: THIS POST IS GENERIC AND IS INTENDED FOR MODIFICATION TO
# THE MACHINE TOOL REQUIREMENTS AND PERSONAL PREFERENCE.
#
# THIS POST REQUIRES A VALID 3 OR 4 AXIS MACHINE DEFINITION.
# YOU WILL RECEIVE AN ERROR MESSAGE IF MORE THAN ONE ROTARY AXIS IS DETECTED IN
# THE ACTIVE AXIS COMBINATION.
#
# Associated File List$
#
# Siemens 808D 3x HMC Mill MM.mcam-mmd
# Siemens 808D 3x HMC Mill.mcam-mmd
# Siemens 808D 3x VMC Mill MM.mcam-mmd
# Siemens 808D 3x VMC Mill.mcam-mmd
# Siemens 808D 3x_4x Mill.mcam-control
# Siemens 808D 4x HMC Mill MM.mcam-mmd
# Siemens 808D 4x HMC Mill.mcam-mmd
# Siemens 808D 4x VMC Mill MM.mcam-mmd
# Siemens 808D 4x VMC Mill.mcam-mmd
# Siemens 840D_828D 3x HMC Mill MM.mcam-mmd
# Siemens 840D_828D 3x HMC Mill.mcam-mmd
# Siemens 840D_828D 3x VMC Mill MM.mcam-mmd
# Siemens 840D_828D 3x VMC Mill.mcam-mmd
# Siemens 840D_828D 3x_4x Mill.mcam-control
# Siemens 840D_828D 4x HMC Mill MM.mcam-mmd
# Siemens 840D_828D 4x HMC Mill.mcam-mmd
# Siemens 840D_828D 4x VMC Mill MM.mcam-mmd
# Siemens 840D_828D 4x VMC Mill.mcam-mmd
# 2019 SIEMENS 3X_4X MILL-AppGuide.pdf
