<UserControl x:Class="SE2SW.SE2SWView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="700" MinHeight="460"
        Background="#F3F5F4"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BBC5C1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#283431" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E9EFEC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#7B928B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCE6E2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#14665C" />
            <Setter Property="BorderBrush" Value="#14665C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="BorderBrush" Value="#BBC5C1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F0" />
            <Setter Property="Foreground" Value="#40504C" />
            <Setter Property="BorderBrush" Value="#DCE2DF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="HorizontalOptionExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="HeaderToggle" Background="Transparent" BorderThickness="0"
                                          Padding="8,5" FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Arrow" Text="›" FontSize="20" FontFamily="Segoe UI Symbol"
                                               Margin="7,-2,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Margin="8,0,0,0"
                                              VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Arrow" Property="Text" Value="‹" />
                            </Trigger>
                            <Trigger SourceName="HeaderToggle" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderToggle" Property="Background" Value="#E9EFEC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="52" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="22,16,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="零件目录" VerticalAlignment="Center" Foreground="#596762" />
            <TextBox Grid.Column="1" Margin="0,0,8,0"
                     Text="{Binding SelectedDirectory, UpdateSourceTrigger=PropertyChanged}"
                     IsEnabled="{Binding CanEdit}" />
            <Button Grid.Column="2" Content="选择文件夹" Click="OnChooseFolderClick" IsEnabled="{Binding CanEdit}" />
            <Button Grid.Column="3" Width="34" Margin="8,0,0,0" Padding="0"
                    Content="⟳" FontFamily="Segoe UI Symbol" FontSize="17"
                    ToolTip="重新扫描" Click="OnScanClick" IsEnabled="{Binding CanEdit}" />
        </Grid>

        <Border Grid.Row="1" Margin="22,0,22,10" Padding="12,8" Background="White"
                BorderBrush="#D7DDDA" BorderThickness="1" CornerRadius="4"
                Visibility="{Binding IsOhsMode, Converter={StaticResource BooleanToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="SE" Foreground="#71807B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SourceDirectory}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SourceDirectory}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="GE" Foreground="#71807B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="{Binding XtDirectory}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding XtDirectory}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="SW" Foreground="#71807B" VerticalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding SolidWorksDirectory}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SolidWorksDirectory}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="22,0,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Expander Grid.Column="0" Header="转换选项" VerticalAlignment="Center"
                      ExpandDirection="Right" Style="{StaticResource HorizontalOptionExpander}"
                      IsEnabled="{Binding CanEdit}">
                <Border Margin="8,0,0,0" Padding="10,8" Background="White"
                        BorderBrush="#D7DDDA" BorderThickness="1" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="识别特征" IsChecked="{Binding RecognizeFeatures}"
                                  ToolTip="导入后使用 FeatureWorks 自动识别特征。" />
                        <CheckBox Content="完全定义草图" Margin="16,0,0,0"
                                  IsChecked="{Binding FullyDefineSketches}"
                                  IsEnabled="{Binding CanFullyDefineSketches}" />
                    </StackPanel>
                </Border>
            </Expander>
            <TextBlock Grid.Column="1" Margin="14,0,0,0" Text="{Binding SelectionText}"
                       VerticalAlignment="Center" Foreground="#596762" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="14,0,0,0">
                <Button Content="全选" Click="OnSelectAllClick" IsEnabled="{Binding CanEdit}" />
                <Button Content="清空" Margin="6,0,0,0" Click="OnClearSelectionClick" IsEnabled="{Binding CanEdit}" />
            </StackPanel>
            <Button Grid.Column="4" Content="{Binding PrimaryActionText}" MinWidth="154"
                    Style="{StaticResource PrimaryButton}"
                    Click="OnConvertClick" IsEnabled="{Binding CanEdit}" />
        </Grid>

        <Border Grid.Row="3" Margin="22,0,22,0" Background="White"
                BorderBrush="#D7DDDA" BorderThickness="1" CornerRadius="4">
            <DataGrid ItemsSource="{Binding Files}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E5EAE7"
                      BorderThickness="0"
                      RowHeight="38"
                      ColumnHeaderHeight="36"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="选择" Width="58">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox">
                                            <Setter Property="IsEnabled" Value="True" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasExistingOutput}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Solid Edge 零件" Binding="{Binding FileName}" Width="2*" IsReadOnly="True" />
                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="92" IsReadOnly="True" />
                    <DataGridTextColumn Header="特征" Binding="{Binding FeatureText}" Width="78" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasFeatureWarning}" Value="True">
                                        <Setter Property="Foreground" Value="#A95E13" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="草图" Binding="{Binding SketchText}" Width="78" IsReadOnly="True" />
                    <DataGridTextColumn Header="结果" Binding="{Binding Detail}" Width="3*" IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="22,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Foreground="#45534F" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}" />
                <ProgressBar Height="3" Margin="0,7,24,0" IsIndeterminate="True"
                             Background="#D9E0DD" Foreground="#14665C">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
            <Button Grid.Column="1" Content="取消" MinWidth="82"
                    Click="OnCancelClick" IsEnabled="{Binding IsRunning}" />
        </Grid>
    </Grid>
</UserControl>
