<UserControl x:Class="SE2SW.AssemblyView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SE2SW"
        MinWidth="760" MinHeight="460"
        Background="#F3F5F4"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        PreviewKeyDown="OnPreviewKeyDown">
    <UserControl.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#BBC5C1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="#283431" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E9EFEC" />
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#7B928B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#DCE6E2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#14665C" />
            <Setter Property="BorderBrush" Value="#14665C" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="BorderBrush" Value="#BBC5C1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EEF1F0" />
            <Setter Property="Foreground" Value="#40504C" />
            <Setter Property="BorderBrush" Value="#DCE2DF" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,0" />
        </Style>
        <Style x:Key="SourcePickerOption" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Height" Value="72" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OptionBorder" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,0,1,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#EDF5F2" />
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#9DBBB2" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#EDF5F2" />
                                <Setter TargetName="OptionBorder" Property="BorderBrush" Value="#14665C" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="OptionBorder" Property="Background" Value="#DCEDE7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HorizontalOptionExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="HeaderToggle" Background="Transparent" BorderThickness="0"
                                          Padding="8,5" FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Arrow" Text="›" FontSize="20" FontFamily="Segoe UI Symbol"
                                               Margin="7,-2,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" ContentSource="Content" Margin="8,0,0,0"
                                              VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Arrow" Property="Text" Value="‹" />
                            </Trigger>
                            <Trigger SourceName="HeaderToggle" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderToggle" Property="Background" Value="#E9EFEC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:AssemblyTreeNode}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" ToolTip="{Binding SourcePath}">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StateText, StringFormat=  · {0}}" Foreground="#71807B" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="22,16,22,10" Height="34" Background="White"
                BorderBrush="#BBC5C1" BorderThickness="1" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="0.85*" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="SourceSelectorButton" Padding="12,0" Background="Transparent" BorderThickness="0"
                        HorizontalContentAlignment="Stretch" Click="OnChooseSourceClick"
                        IsEnabled="{Binding CanEdit}" ToolTip="点击选择装配体或零件文件夹">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SourceLabel}" Foreground="#596762" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis"
                                   Foreground="#283431" VerticalAlignment="Center" ToolTip="{Binding SourcePath}" />
                    </Grid>
                </Button>
                <Border Grid.Column="1" BorderBrush="#D7DDDA" BorderThickness="1,0,0,0">
                    <Button Padding="12,0" Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Stretch" Click="OnOpenXtDirectoryClick"
                            ToolTip="点击打开 XT 输出目录">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="XT 目录" Foreground="#71807B" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding XtDirectory}" TextTrimming="CharacterEllipsis"
                                       Foreground="#283431" VerticalAlignment="Center" ToolTip="{Binding XtDirectory}" />
                        </Grid>
                    </Button>
                </Border>
                <Border Grid.Column="2" BorderBrush="#D7DDDA" BorderThickness="1,0,0,0">
                    <Button Padding="12,0" Background="Transparent" BorderThickness="0"
                            HorizontalContentAlignment="Stretch" Click="OnOpenSolidWorksDirectoryClick"
                            ToolTip="点击打开 SW 输出目录">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="SW 目录" Foreground="#71807B" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding SolidWorksDirectory}" TextTrimming="CharacterEllipsis"
                                       Foreground="#283431" VerticalAlignment="Center" ToolTip="{Binding SolidWorksDirectory}" />
                        </Grid>
                    </Button>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22,0,22,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition>
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="2*" />
                            <Setter Property="MinWidth" Value="250" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPartDirectoryMode}" Value="True">
                                    <Setter Property="Width" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
                <ColumnDefinition Width="3*" MinWidth="350" />
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#D7DDDA" BorderThickness="1"
                    CornerRadius="4" Margin="0,0,7,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPartDirectoryMode}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="装配结构" Padding="11,9"
                               FontWeight="SemiBold" Foreground="#34413F" Background="#EEF1F0" />
                    <TreeView ItemsSource="{Binding AssemblyTree}" BorderThickness="0" Padding="8" />
                </DockPanel>
            </Border>
            <Border Background="White" BorderBrush="#D7DDDA" BorderThickness="1" CornerRadius="4">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Grid.Column" Value="1" />
                        <Setter Property="Grid.ColumnSpan" Value="1" />
                        <Setter Property="Margin" Value="7,0,0,0" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPartDirectoryMode}" Value="True">
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="Margin" Value="0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PartsPanelTitle}" Padding="11,9"
                               FontWeight="SemiBold" Foreground="#34413F" Background="#EEF1F0" />
                    <DataGrid ItemsSource="{Binding Parts}" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserResizeRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E5EAE7" BorderThickness="0" RowHeight="36"
                              ColumnHeaderHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Solid Edge 零件" Binding="{Binding FileName}" Width="2*" MinWidth="180" />
                            <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="82" />
                            <DataGridTextColumn Header="特征" Binding="{Binding FeatureText}" Width="68" />
                            <DataGridTextColumn Header="草图" Binding="{Binding SketchText}" Width="68" />
                            <DataGridTextColumn Header="结果" Binding="{Binding Detail}" Width="2.4*" MinWidth="180" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="22,0,22,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Expander Header="转换选项" VerticalAlignment="Center" HorizontalAlignment="Left"
                      ExpandDirection="Right" Style="{StaticResource HorizontalOptionExpander}"
                      IsEnabled="{Binding CanEdit}">
                <Border Margin="8,0,0,0" Padding="10,8" Background="White"
                        BorderBrush="#D7DDDA" BorderThickness="1" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Content="识别特征" IsChecked="{Binding RecognizeFeatures}" />
                        <CheckBox Content="完全定义草图" Margin="16,0,0,0"
                                  IsChecked="{Binding FullyDefineSketches}"
                                  IsEnabled="{Binding CanFullyDefineSketches}" />
                        <CheckBox Content="零件失败时继续" Margin="16,0,0,0"
                                  IsChecked="{Binding ContinueWhenPartFails}"
                                  IsEnabled="{Binding CanContinueWhenPartFails}" />
                        <CheckBox Content="重建装配关系（默认开启）" Margin="16,0,0,0"
                                  IsChecked="{Binding RebuildMates}"
                                  IsEnabled="{Binding CanRebuildMates}"
                                  ToolTip="{Binding RebuildMatesHint}" />
                    </StackPanel>
                </Border>
            </Expander>
            <Button Grid.Column="1" Content="{Binding PrimaryActionText}" MinWidth="138"
                    Style="{StaticResource PrimaryButton}" Click="OnConvertClick"
                    IsEnabled="{Binding CanConvert}" />
        </Grid>

        <Grid Grid.Row="3" Margin="22,0,22,9">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Foreground="#45534F" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding StatusText}" />
                <ProgressBar Height="3" Margin="0,7,24,0" IsIndeterminate="True"
                             Background="#D9E0DD" Foreground="#14665C">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>
            </StackPanel>
            <Button Grid.Column="1" Content="取消" MinWidth="82"
                    Click="OnCancelClick" IsEnabled="{Binding IsBusy}" />
        </Grid>

        <Grid x:Name="SourcePickerOverlay" Grid.RowSpan="4" Panel.ZIndex="10"
              Background="#5C13211D" Visibility="Collapsed" Focusable="True"
              MouseLeftButtonDown="OnSourcePickerBackdropMouseLeftButtonDown">
            <Border Width="440" MaxWidth="440" Background="White" BorderBrush="#AEBDB7"
                    BorderThickness="1" CornerRadius="6" Padding="0"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.22" Color="#263A34" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="20,17,12,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="32" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="选择转换来源" FontSize="17" FontWeight="SemiBold"
                                       Foreground="#20312D" />
                            <TextBlock Text="选择需要转换的 Solid Edge 内容" Margin="0,4,0,0"
                                       Foreground="#66756F" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="28" Height="28" Padding="0" Content="X"
                                Background="Transparent" BorderBrush="Transparent"
                                ToolTip="关闭" Click="OnCloseSourcePickerClick" />
                    </Grid>
                    <Button Grid.Row="1" Style="{StaticResource SourcePickerOption}"
                            Click="OnChooseAssemblyClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="30" Background="#E1F0EA" CornerRadius="3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="ASM" Foreground="#14665C" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="装配体" FontWeight="SemiBold" Foreground="#263734" />
                                <TextBlock Text="解析结构、位置与装配关系" Margin="0,3,0,0"
                                           Foreground="#71807B" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text=">" FontSize="18" Foreground="#5C766D"
                                       Margin="12,0,2,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Grid.Row="2" Style="{StaticResource SourcePickerOption}"
                            Click="OnChoosePartDirectoryClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="30" Background="#EEF1F0" CornerRadius="3"
                                    VerticalAlignment="Center">
                                <TextBlock Text="PAR" Foreground="#405B53" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="零件文件夹" FontWeight="SemiBold" Foreground="#263734" />
                                <TextBlock Text="转换所选目录顶层的零件" Margin="0,3,0,0"
                                           Foreground="#71807B" FontSize="12" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text=">" FontSize="18" Foreground="#5C766D"
                                       Margin="12,0,2,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Grid.Row="3" Height="1" Background="#DCE2DF" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
