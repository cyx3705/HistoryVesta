<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Version>3.1.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SE2SW.Smoke" />
    <ProjectReference Include="..\SE2SW.Contracts\SE2SW.Contracts.csproj" />
    <ProjectReference Include="..\SE2SW.Worker\SE2SW.Worker.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="OneHistory.AppShell.Core" Version="3.0.3" />
  </ItemGroup>
  <Target Name="CopyWorkerArtifacts" AfterTargets="Build">
    <ItemGroup>
      <WorkerArtifact Include="..\SE2SW.Worker\bin\$(Configuration)\net8.0-windows\win-x64\SE2SW.Worker.exe" />
      <WorkerArtifact Include="..\SE2SW.Worker\bin\$(Configuration)\net8.0-windows\win-x64\SE2SW.Worker.dll" />
      <WorkerArtifact Include="..\SE2SW.Worker\bin\$(Configuration)\net8.0-windows\win-x64\SE2SW.Worker.deps.json" />
      <WorkerArtifact Include="..\SE2SW.Worker\bin\$(Configuration)\net8.0-windows\win-x64\SE2SW.Worker.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(WorkerArtifact)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
