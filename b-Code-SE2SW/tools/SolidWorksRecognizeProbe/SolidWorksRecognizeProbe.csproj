<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>SolidWorksRecognizeProbe</AssemblyName>
    <RootNamespace>SolidWorksRecognizeProbe</RootNamespace>
    <SwApiRedist Condition="'$(SwApiRedist)' == ''">C:\Program Files\SOLIDWORKS\SOLIDWORKS Corp\SOLIDWORKS\api\redist</SwApiRedist>
  </PropertyGroup>

  <!--
    与 Solid Edge 相反：Dassault 在 api\redist 下正式提供可再分发的 Interop 程序集，
    所以这里用普通 <Reference>，dotnet build 可以直接构建，不需要 VS 版 MSBuild。
    EmbedInteropTypes=false：SolidWorks 的 Interop 是托管包装而非纯 COM 元数据，嵌入会丢事件与类。
    路径通过 SwApiRedist 属性可覆盖；正式实现应改为从注册表探测安装目录。
  -->
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SwApiRedist)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SwApiRedist)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.fworks">
      <HintPath>$(SwApiRedist)\SolidWorks.Interop.fworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
