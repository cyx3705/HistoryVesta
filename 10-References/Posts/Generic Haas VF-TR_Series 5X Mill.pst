[POST_VERSION] #DO NOT MOVE OR ALTER THIS LINE# V22.00 P0 E1 W22.00 T1550094732 M22.00 I0 O1
scncpost_revision     := "22.81" # Internal revision number for use by CNC Software only.  Please do not change this number.
scustpost_revision    := "0"  # Revision number for use by Resellers or customers.
# Post Name           : Generic Haas VF-TR_Series 5X Mill
# Product             : Mill
# Machine Name        : Haas VF - TR Series
# Control Name        : Haas
# Description         : Haas VF with 5-axis Trunnion
# 4-axis/Axis subs.   : Yes
# 5-axis              : Yes
# Subprograms         : No
# Executable          : mp.dll
#
# WARNING: THIS POST IS GENERIC AND IS INTENDED FOR MODIFICATION TO
# THE MACHINE TOOL REQUIREMENTS AND PERSONAL PREFERENCE.
#
# Associated File List$
#
# GENERIC HAAS VF-TR_SERIES 5X MILL.MCAM-CONTROL
# GENERIC HAAS VF-TR_SERIES 5X MILL.MCAM-MMD
# GENERIC HAAS VF-TR_SERIES 5X MILL MM.MCAM-MMD
#
# Associated File List$
#
# --------------------------------------------------------------------------
# Revision log:
# --------------------------------------------------------------------------
# Programmers Note:
