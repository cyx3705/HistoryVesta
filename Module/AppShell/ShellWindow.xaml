<Window x:Class="OneHistory.AppShell.Desktop.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AppShell V4.0"
        Width="1280"
        Height="800"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ShellSurface}"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource ShellBlue}">
            <DockPanel Margin="18,0">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="AppShell" Foreground="White" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="V4.0 Desktop Shell" Foreground="#D8E7F4" FontSize="11" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="首页" Click="OnHomeClick" />
                    <Button Content="打开实验页" Click="OnOpenScratchPageClick" />
                    <Button Content="关闭当前页" Click="OnClosePageClick" Margin="0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="{StaticResource ShellBorder}"
                    BorderThickness="1"
                    Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Margin="6,4,6,10"
                               Text="页面"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ShellText}" />
                    <ListBox x:Name="PageList"
                             ItemsSource="{Binding Pages}"
                             DisplayMemberPath="Title"
                             SelectionChanged="OnPageSelectionChanged"
                             AllowDrop="True"
                             PreviewMouseLeftButtonDown="OnPageListMouseLeftButtonDown"
                             PreviewMouseMove="OnPageListMouseMove"
                             DragOver="OnPageListDragOver"
                             Drop="OnPageListDrop" />
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="White"
                    BorderBrush="{StaticResource ShellBorder}"
                    BorderThickness="1"
                    AllowDrop="True"
                    DragOver="OnPageHostDragOver"
                    Drop="OnPageHostDrop">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#EAF1F7" Padding="16,10">
                        <TextBlock x:Name="PageTitle"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ShellText}" />
                    </Border>
                    <ContentControl x:Name="PageHost" />
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E7ECF1" Padding="12,0">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="#52606D"
                       FontSize="11" />
        </Border>
    </Grid>
</Window>
