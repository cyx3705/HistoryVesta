<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
    <Product>HistoryVulcanPackageSmoke</Product>
    <AssemblyTitle>HistoryVulcanPackageSmoke</AssemblyTitle>
    <Title>HistoryVulcanPackageSmoke</Title>
    <!-- The release script restores this project from the freshly built local feed. -->
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="OneHistory.HistoryVulcan.Shell" />
    <PackageReference Include="OneHistory.HistoryVulcan.ServiceHost" />
  </ItemGroup>

</Project>
